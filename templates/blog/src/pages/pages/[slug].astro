---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PageArticle from "../../components/PageArticle.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const settings = await getSiteSettings();
const { siteTitle } = resolveBlogSiteIdentity(settings);
// The homepage renders this page at "/" too, so that copy is the canonical one.
// The setting stores the translation group, which names every translation of it.
const isHomepage =
	settings.homepage?.collection === "pages" &&
	settings.homepage.id === page.data.translationGroup;
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: isHomepage ? "/" : Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<PageArticle
		title={page.data.title}
		content={page.data.content}
		edit={page.edit}
	/>
</Base>
