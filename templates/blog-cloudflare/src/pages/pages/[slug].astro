---
import {
	getEmDashEntry,
	resolveProtectedEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
	optInPageCache,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PageArticle from "../../components/PageArticle.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { loadWpShell } from "../../utils/wp-shell-loader";
import { readPageFeatured } from "../../utils/wp-page-featured.js";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: publicPage, cacheHint } = await getEmDashEntry("pages", slug);

if (!publicPage) {
	return Astro.redirect("/404");
}

// A site migrated from WordPress keeps its own design (layouts/WpShell.astro).
if ((await loadWpShell()).shell) {
	// The query goes along: a rewrite to a path drops it, and the layout reads it (`?subscribe=`).
	return Astro.rewrite(`/wp-shell/pages/${encodeURIComponent(slug)}${Astro.url.search}`);
}

const access = await resolveProtectedEntry(Astro, "pages", publicPage);
if ("response" in access) return access.response;
const page = access.entry;
if (Astro.cache?.enabled && !access.protected) {
	Astro.cache.set(cacheHint);
	optInPageCache(300);
}
const settings = await getSiteSettings();
const { siteTitle } = resolveBlogSiteIdentity(settings);
// The homepage renders this page at "/" too, so that copy is the canonical one.
// The setting stores the translation group, which names every translation of it.
const isHomepage =
	settings.homepage?.collection === "pages" &&
	settings.homepage.id === page.data.translationGroup;
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: isHomepage ? "/" : Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<PageArticle
		title={page.data.title}
		content={page.data.content}
		edit={page.edit}
		pageFeatured={readPageFeatured(page.data)}
	/>
</Base>
