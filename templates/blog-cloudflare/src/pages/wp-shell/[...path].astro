---
/**
 * The pages of a site migrated from WordPress, in its own design.
 *
 * Reached ONLY through Astro.rewrite() from `/`, `/pages/[slug]` and
 * `/posts/[slug]` when the site has a shell record: the visitor's URL stays
 * the one they asked for. A request for /wp-shell/... itself is a 404, so the
 * same page is never served at two addresses.
 *
 * This route exists so that the page is built from a module graph that does
 * not contain Base.astro: Astro bundles a route's CSS from every component the
 * route imports, rendered or not, and Base's global resets and design tokens
 * would otherwise sit under the WordPress theme's stylesheets.
 */
import {
	decodeSlug,
	getCollectionInfo,
	getCommentCount,
	getContentSeo,
	getEmDashCollection,
	getEmDashEntry,
	resolveProtectedEntry,
	getHomepage,
	getSeoMeta,
	getSiteSettings,
	optInPageCache,
	type InferCollectionData,
} from "emdash";
import { Comments, CommentForm } from "emdash/ui/comments";
import WpShellComments from "../../components/WpShellComments.astro";
import WpShell from "../../layouts/WpShell.astro";
import { featuredImageUrl } from "../../utils/og-image";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { wpShellPostFill, wpShellRoute } from "../../utils/wp-shell";
import { loadWpShell } from "../../utils/wp-shell-loader";

const origin = Astro.originPathname;
const route = wpShellRoute(Astro.params.path);
// A date archive has its own route (wp-shell/archive/[...date].astro), which draws no entry.
if (!route || route.kind === "archive" || origin.startsWith("/wp-shell")) {
	return new Response(null, { status: 404 });
}

const [{ shell, cacheHint: shellHint }, settings] = await Promise.all([
	loadWpShell(),
	getSiteSettings(),
]);
// The record went away between the page route's read and this one (its TTL
// ran out): the page route draws the page in this template's own design.
if (!shell) return Astro.rewrite(origin);
if (Astro.cache?.enabled) Astro.cache.set(shellHint);

const { siteTitle } = resolveBlogSiteIdentity(settings);

async function load(r: Exclude<NonNullable<typeof route>, { kind: "archive" }>) {
	if (r.kind === "home") {
		const homepage = await getHomepage<InferCollectionData<"pages">>();
		return {
			entry: homepage.entry,
			collection: homepage.collection ?? "pages",
			cacheHint: homepage.cacheHint,
		};
	}
	const collection = r.kind === "page" ? "pages" : "posts";
	const slug = decodeSlug(r.slug);
	if (!slug) return { entry: null, collection, cacheHint: undefined };
	const result = await getEmDashEntry(collection, slug);
	return { entry: result.entry, collection, cacheHint: result.cacheHint };
}
const { entry: publicEntry, collection, cacheHint } = await load(route);
if (!publicEntry) return Astro.rewrite(origin);
const access = await resolveProtectedEntry(Astro, collection, publicEntry);
if ("response" in access) return access.response;
// Narrowed once here: astro check does not carry the "response" in-check through the frontmatter return.
const accessProtected = "protected" in access && access.protected;
const entry = access.entry;
if (Astro.cache?.enabled && cacheHint && !accessProtected) {
	Astro.cache.set(cacheHint);
	optInPageCache(300);
}

const isPost = route.kind === "post";
const path = route.kind === "home" ? "/" : origin.replace(/\/$/, "");
const data = entry.data;
// The homepage renders its page at "/" too, so that copy is the canonical one.
const isHomepage =
	route.kind === "home" ||
	(settings.homepage?.collection === collection && settings.homepage.id === data.translationGroup);
const seo = getSeoMeta(entry, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: isHomepage ? "/" : path,
	...(isPost && "featured_image" in data
		? { defaultOgImage: featuredImageUrl(data.featured_image, Astro.url.origin) }
		: {}),
});

// A post drawn in the record's post layout: its own values for the layout's holes. The comment
// count, and the posts published before and after it, are read only where the layout prints them.
async function adjacent(published: Date | null | undefined) {
	if (!isPost || !shell?.post?.adjacent || !published) return { prev: null, next: null };
	const at = published.toISOString();
	const [before, after] = await Promise.all([
		getEmDashCollection("posts", { where: { published_at: { lt: at } }, orderBy: { published_at: "desc" }, limit: 1 }),
		getEmDashCollection("posts", { where: { published_at: { gt: at } }, orderBy: { published_at: "asc" }, limit: 1 }),
	]);
	if (Astro.cache?.enabled && !accessProtected) for (const r of [before, after]) Astro.cache.set(r.cacheHint);
	const [prev, next] = [before, after].map((r) => {
		const e = r.entries[0];
		return e ? { title: e.data.title, url: `/posts/${e.id}` } : null;
	});
	return { prev, next };
}
/**
 * The reading time as the source's line phrases it: "less than 1" under a
 * minute, "N" otherwise. The record's line keeps the theme's own unit and word
 * ("minute read"), so the reader gives it only the quantity. EmDash's own
 * `getReadingTime` counts the post's words.
 */
function readingQuantity(content: unknown): string {
	const blocks = Array.isArray(content) ? (content as Parameters<typeof getReadingTime>[0]) : undefined;
	const minutes = getReadingTime(blocks);
	return minutes < 1 ? "less than 1" : String(Math.round(minutes));
}

/**
 * The posts related to this one, drawn from the NEW site's own content: the
 * posts sharing most of its tags, newest first, at most the count the source
 * drew. The source's own related posts are never copied — their links would
 * rot as the site changes.
 */
async function relatedPosts(tags: readonly { slug: string }[], count: number, self: string) {
	if (count <= 0) return [];
	const newest = await getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 50 });
	if (Astro.cache?.enabled && !accessProtected) Astro.cache.set(newest.cacheHint);
	const mine = new Set(tags.map((t) => t.slug));
	return newest.entries
		.filter((e) => e.id !== self)
		.map((e) => {
			const theirs = (Array.isArray(e.data.terms?.tag) ? e.data.terms.tag : []).flatMap((t: unknown) => (isObject(t) && typeof t.slug === "string" ? [t.slug] : []));
			return { entry: e, shared: theirs.filter((slug) => mine.has(slug)).length };
		})
		.filter((r) => r.shared > 0)
		.toSorted((a, b) => b.shared - a.shared)
		.slice(0, count)
		.map((r) => ({ title: r.entry.data.title, url: `/posts/${r.entry.id}` }));
}

const isObject = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v);
const relatedCount = shell?.post?.related?.count ?? 0;
const post =
	isPost && shell.post
		? wpShellPostFill(data, {
				url: path,
				origin: Astro.url.origin,
				comments: shell.post.comments ? await getCommentCount("posts", data.id) : null,
				...(await adjacent(data.publishedAt)),
				readingTime: shell.post.readingTime ? readingQuantity(data.content) : null,
				// `entry.id`, not `data.id`: the collection's entries are keyed by the public id
				// (the slug), and comparing the database id against it never matched, so a post
				// listed itself in its own strip.
				related: shell.post.related ? await relatedPosts(data.terms?.tag ?? [], relatedCount, entry.id) : null,
			})
		: null;
// The post layout's comment element holds EmDash's comments itself: in the theme's comment area where
// the record carries one. With comments off, the element is not drawn either: WordPress draws no comment
// area for a post that takes none.
const layoutComments = Boolean(post && shell.post?.parts.some((p) => "slot" in p && p.slot === "comments"));
const commentsOn = isPost && ((await getCollectionInfo("posts"))?.commentsEnabled ?? false);
const area = layoutComments && shell.post?.commentArea ? shell.post : null;
---

<WpShell
	shell={shell}
	kind={route.kind}
	path={route.kind === "home" ? "/" : origin}
	slug={route.kind === "post" ? null : entry.id}
	title={seo.title}
	seoTitle={getContentSeo(entry)?.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type={isPost ? "article" : "website"}
	publishedTime={isPost ? (data.publishedAt?.toISOString() ?? null) : null}
	modifiedTime={isPost ? data.updatedAt.toISOString() : null}
	content={{ collection, id: data.id, slug: entry.id }}
	entry={{
		title: data.title,
		body: data.content,
		excerpt: "excerpt" in data && typeof data.excerpt === "string" ? data.excerpt : null,
		edit: entry.edit,
	}}
	post={post}
	comments={commentsOn}
>
	{
		commentsOn &&
			(area ? (
				<WpShellComments post={area} contentId={data.id} title={data.title} />
			) : layoutComments ? (
				<Fragment>
					<Comments collection="posts" contentId={data.id} threaded />
					<CommentForm collection="posts" contentId={data.id} />
				</Fragment>
			) : (
				<div class="comments-wrapper section-inner">
					<Comments collection="posts" contentId={data.id} threaded />
					<CommentForm collection="posts" contentId={data.id} />
				</div>
			))
	}
</WpShell>
