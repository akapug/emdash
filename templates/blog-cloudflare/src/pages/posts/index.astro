---
import { getEmDashCollection, getSiteSettingsWithCacheHint, getTermsForEntries, optInPageCache } from "emdash";
import Base from "../../layouts/Base.astro";
import { POST_CARD_IMAGE_SIZES } from "../../utils/image-sizes";
import { getReadingTime } from "../../utils/reading-time";
import { wpShellIndexRoute } from "../../utils/wp-shell";
import { loadWpShell } from "../../utils/wp-shell-loader";
import { cardPicture, storedDimensionsForRender } from "emdash";
// THE PICTURE IS DRAWN BY THE IMAGE COMPONENT, not by a hand-built <img>.
//
// A raw <img> here could only ever name the original: the component is what asks the tenant for the widths it
// actually holds and emits a srcset of DISTINCT variant URLs, with a slot width that describes a card. Hand-built
// markup cannot do that, and an invented list would be worse than none.
import { Image } from "emdash/ui";

// A site whose record carries a posts index (cut from its own listing page) keeps its own design here: the
// query goes along (`?cursor=`, `?subscribe=`). Any other site, a WordPress one too, draws this template's.
const [{ shell }, settingsResult] = await Promise.all([
	loadWpShell(),
	getSiteSettingsWithCacheHint(),
]);
const shellIndex = wpShellIndexRoute(shell, Astro.url.search);
if (shellIndex) return Astro.rewrite(shellIndex);

const perPage = Math.min(100, Math.max(1, settingsResult.data.postsPerPage || 10));

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: perPage,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(cacheHint);
	optInPageCache(300);
}

// Single batched query for tags across all posts, instead of one
// getEntryTerms() call per post (which would be N round-trips).
// Bylines are already hydrated on entry.data.bylines.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

// THE CARD'S PICTURE, decided here so every card asks the same question. The listing already loads each post's
// content (`getReadingTime(post.data.content)` below reads it), so this costs no extra query. Measured against the
// live theme, card for card: her card draws the FIRST picture of the post's own content, and none of 45 posts
// carried a featured image — so a card that follows this rule shows what her site shows.
//
// AND THE CARD CARRIES THE PICTURE'S OWN DIMENSIONS, because without them the image component cannot offer the widths
// the tenant holds: Astro's <Image> refuses a remote src with no width and height, so the picture would be drawn once
// at its original size — the multi-megabyte file this lane exists for. A `featured_image` value that already states
// its size wins (it is the one the editor chose); otherwise the media row's own size is read, request-cached, so a
// listing of twenty cards naming one attachment asks once.
const withPictures = await Promise.all(
	posts.map(async (post) => {
		const picture = cardPicture({
			featuredImage: (post.data as { featured_image?: unknown }).featured_image,
			content: post.data.content,
		}, {
			// THE CONTENT-FIRST WALK IS THE SITE'S CHOICE, as the SECOND argument. The import turns it on only where
			// the source's own listing was SEEN drawing a card picture for a post with no featured image: measured
			// across real sources the answers differ, so a default would be one site's answer on another's pages. It
			// is read from the site settings the page already loads, the same channel the iframe allowlist uses.
			contentFirst: settingsResult.data.cardContentFirst === true,
		});
		const stated = (post.data as { featured_image?: { width?: unknown; height?: unknown } }).featured_image;
		const width = Number(stated?.width ?? 0);
		const height = Number(stated?.height ?? 0);
		const measured =
			width > 0 && height > 0
				? { width, height }
				: picture
					? await storedDimensionsForRender({ url: picture.assetRef ?? picture.src })
					: null;
		return { post, picture, dimensions: measured };
	}),
);

/**
 * The image value the card hands the component.
 *
 * TYPED, because the component's `image` prop is `string | ImageValue | null | undefined` and an inline object literal
 * with optional width/height does not narrow to it — the fork's astro check rejects the object at the call site rather
 * than inside the component. The dimensions are the row's own, when the card could read them.
 */
function cardImage(
	picture: { assetRef?: string; src: string; alt?: string; focalX?: number; focalY?: number },
	dimensions: { width: number; height: number } | undefined,
	fallbackAlt: string,
): {
	id: string;
	src: string;
	alt: string;
	width?: number;
	height?: number;
	focalX?: number;
	focalY?: number;
} {
	// `id` IS REQUIRED BY THE COMPONENT'S `ImageValue`, even though the local branch draws from `src`: the type is the
	// media record, and the fork's own components pass the id so a provider can resolve the current file.
	//
	// IT IS THE WHOLE KEY, DECODED — not the first path segment. The old regex `/\/media\/file\/([^/?#]+)/` stopped at
	// the first `/`, so a NESTED key `2024/05/x.jpg` yielded id `"2024"`, and an encoded key yielded a percent-encoded
	// id. `EmDashImage` falls back to `img.id` when it has no storage key, so a wrong id there means the wrong file.
	const src = picture.assetRef ?? picture.src;
	const fromRoute = /^\/_emdash\/api\/media\/file\/(.+)$/.exec(src)?.[1];
	const id = fromRoute
		? fromRoute
				.split("/")
				.map((segment) => {
					try {
						return decodeURIComponent(segment);
					} catch {
						return segment;
					}
				})
				.join("/")
		: src;
	return {
		id,
		src,
		alt: picture.alt || fallbackAlt,
		...(dimensions ? { width: dimensions.width, height: dimensions.height } : {}),
		// THE FOCAL POINT TRAVELS WITH THE PICTURE. `EmDashImage` turns it into `object-position`, so dropping it here
		// cropped every card at the centre — including photos whose subject the owner had explicitly moved.
		...(picture.focalX !== undefined ? { focalX: picture.focalX } : {}),
		...(picture.focalY !== undefined ? { focalY: picture.focalY } : {}),
	};
}

const postsWithTags = withPictures.map(({ post, picture, dimensions }) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
	bylines: post.data.bylines ?? [],
	picture,
	...(dimensions ? { dimensions } : {}),
}));

const formatDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
---

<Base title="All Posts" description="Browse all blog posts">
	<div class="posts-page">
		<header class="page-header">
			<h1 class="page-title">All Posts</h1>
			<p class="page-description">
				{posts.length}{" "}
				{posts.length === 1 ? "article" : "articles"}
			</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="empty">No posts yet.</p>
			) : (
				<div class="posts-list">
					{postsWithTags.map(({ post, tags, bylines, picture, dimensions }) => (
						<article class="post-item">
							<a href={`/posts/${post.id}`} class="post-link">
								{picture && (
									<span class="post-picture">
										{/* `src` IS THE PICTURE AS THE PICKER FOUND IT, ALREADY A PATH when it came from a
										    stored asset's _ref (measured: "/_emdash/api/media/file/<id>.<ext>"). The component
										    reads the widths the tenant holds; with none it draws the original once and
										    claims no srcset, which is the honest markup. */}
										{/* THE ROW'S OWN SIZE, so the component can offer the widths the tenant holds instead of
										    drawing the original once. Absent, it draws a plain <img> — never a srcset it cannot
										    back. A JSX comment cannot sit between attributes, which is why this one is here. */}
										<Image
											image={cardImage(picture, dimensions, post.data.title)}
											sizes={POST_CARD_IMAGE_SIZES}
											loading="lazy"
											decoding="async"
										/>
									</span>
								)}
								<div class="post-meta">
									{bylines.length > 0 && (
										<>
											<div class="post-bylines">
												{bylines.slice(0, 2).map((credit, index) => (
													<>
														{index > 0 && <span class="byline-sep">,</span>}
														<span class="post-byline">
															{credit.byline.avatarMediaId && (
																<img
																	src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
																	alt={credit.byline.displayName}
																	class="post-byline-avatar"
																/>
															)}
															<span class="post-byline-name">
																{credit.byline.displayName}
															</span>
														</span>
													</>
												))}
												{bylines.length > 2 && (
													<span class="byline-more">+{bylines.length - 2}</span>
												)}
											</div>
											<span class="meta-dot" />
										</>
									)}
									{post.data.publishedAt && (
										<time>{formatDate(post.data.publishedAt)}</time>
									)}
									{post.data.publishedAt && <span class="meta-dot" />}
									<span>{getReadingTime(post.data.content)} min read</span>
								</div>
								<h2 class="post-title" {...post.edit.title}>{post.data.title}</h2>
								{post.data.excerpt && (
									<p class="post-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
								)}
							</a>
							{tags.length > 0 && (
								<div class="post-tags">
									{tags.slice(0, 3).map((t) => (
										<a href={`/tag/${t.slug}`} class="post-tag">
											{t.label}
										</a>
									))}
								</div>
							)}
						</article>
					))}
				</div>
			)
		}
		<nav class="pagination" aria-label="Pagination">
			{cursor && <a href="/posts">First page</a>}
			{
				nextCursor && (
					<a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>
						Next page
					</a>
				)
			}
		</nav>
	</div>
</Base>

<style>
	.posts-page {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-12);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.page-description {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.posts-list {
		display: flex;
		flex-direction: column;
	}

	/* MEASURED from her live card: 206x116 at a 16:9 ratio with the picture filling the box, alt = the post title.
	   object-fit: cover rather than her effective `fill` so a picture of another ratio cannot squash. */
	.post-picture {
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		margin-bottom: var(--spacing-4);
	}

	.post-picture img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.post-item {
		padding: var(--spacing-8) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.post-item:first-child {
		padding-top: 0;
	}

	.post-item:last-child {
		border-bottom: none;
	}

	.post-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-bottom: var(--spacing-2);
	}

	.meta-dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--color-muted);
	}

	/* Post bylines */
	.post-bylines {
		display: flex;
		align-items: center;
		gap: 2px;
	}

	.post-byline {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-1);
	}

	.post-byline-avatar {
		width: var(--avatar-size-sm);
		height: var(--avatar-size-sm);
		border-radius: 50%;
		object-fit: cover;
	}

	.post-byline-name {
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.byline-sep {
		color: var(--color-muted);
		margin-right: 2px;
	}

	.byline-more {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-left: 2px;
	}

	.post-title {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.post-link:hover .post-title {
		color: var(--color-brand);
	}

	.post-excerpt {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-top: var(--spacing-4);
	}

	.post-tag {
		display: inline-block;
		padding: var(--tag-padding-y) var(--spacing-2);
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);
		background: var(--color-surface);
		border-radius: var(--radius);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			background var(--transition-fast);
	}

	.post-tag:hover {
		color: var(--color-text);
		background: var(--color-border);
	}

	@media (max-width: 600px) {
		.posts-page {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.page-title {
			font-size: var(--font-size-3xl);
		}

		.post-title {
			font-size: var(--font-size-xl);
		}
	}
</style>
