---
import * as emdashModule from "emdash";
import { getSiteSettingsWithCacheHint } from "emdash";
import EventFacts from "./EventFacts.astro";
import EventCover from "./EventCover.astro";
import { boundEventPageCache } from "../utils/event-page-cache.js";
import {
	eventAvailableYears,
	eventCalendarGrid,
	eventExcerpt,
	eventMonthNavigation,
	eventSearchQuery,
	eventSummary,
	eventString,
	eventPage,
	eventViewDisplayMode,
	eventViewTabUrls,
	filterEventsBySearch,
	formatEventMecFullDate,
	formatEventMonth,
	formatEventMonthName,
	formatEventTimes,
	groupEventsByMonth,
	selectEventView,
	sortEvents,
	type EventEntry,
	type EventView,
	type EventMonthNavigation,
	type EventPage,
} from "../utils/events.js";
interface Props {
	entries: EventEntry[];
	now?: Date;
	view?: EventView;
	unavailable?: boolean;
	navigation?: EventMonthNavigation;
	timezone?: string;
	pageSize?: number;
}
const {
	entries,
	now = new Date(),
	view,
	unavailable = false,
	navigation,
	timezone,
	pageSize,
} = Astro.props;
const paginated = !view || view.layout === "list";
const site =
	timezone === undefined || (paginated && pageSize === undefined)
		? await getSiteSettingsWithCacheHint()
		: null;
const perPage = pageSize ?? site?.data.postsPerPage;
const referenceTimezone = timezone ?? eventString(site?.data.timezone);
const locale = Astro.currentLocale ?? eventString(entries[0]?.data.locale);
if (Astro.cache?.enabled) Astro.cache.set(false);
const events = entries.flatMap((entry) => {
	const summary = eventSummary(entry, now, undefined, referenceTimezone);
	return summary ? [summary] : [];
});
const url = new URL(Astro.originPathname + Astro.url.search, Astro.url.origin);
if (unavailable || url.search !== "") {
	if ("optOutPageCache" in emdashModule && typeof emdashModule.optOutPageCache === "function") {
		emdashModule.optOutPageCache();
	}
} else {
	boundEventPageCache(events, now, referenceTimezone);
}
const searchBar = view?.searchBar;
const searchQuery = view && searchBar ? eventSearchQuery(view, url) : null;
const isListSkin = view?.layout === "list";
const isMecStyle = view?.dateStyle === "mec";
const isMecHomeGrid = isMecStyle && view?.layout === "grid";
const isUpcomingList = isListSkin && view?.mode === "upcoming";
const displayMode = view && isUpcomingList ? eventViewDisplayMode(view, url) : "list";
const tabUrls = view && isUpcomingList ? eventViewTabUrls(view, url) : null;
let monthlyNav: EventMonthNavigation | null = null;
if (view && isUpcomingList && displayMode === "monthly") {
	monthlyNav = eventMonthNavigation(view, url, now, referenceTimezone);
	if (!monthlyNav) {
		const normalized = new URL(url);
		normalized.searchParams.delete(`events-month[${view.viewSlug}]`);
		monthlyNav = eventMonthNavigation(view, normalized, now, referenceTimezone);
	}
}
const calendarWeeks =
	view && monthlyNav
		? eventCalendarGrid(entries, view, monthlyNav.month, now, referenceTimezone, searchQuery)
		: [];
const baseViewEvents = view ? selectEventView(events, view, now, navigation?.month) : [];
const availableYears =
	view && searchBar?.monthYear ? eventAvailableYears(baseViewEvents, view.order) : [];
const months = [
	"01",
	"02",
	"03",
	"04",
	"05",
	"06",
	"07",
	"08",
	"09",
	"10",
	"11",
	"12",
];
const ownedSearchKeys = view
	? new Set([
			`events-q[${view.viewSlug}]`,
			`events-month-num[${view.viewSlug}]`,
			`events-year[${view.viewSlug}]`,
			`events-page[${view.viewSlug}]`,
		])
	: new Set<string>();
const preservedParams = searchBar
	? [...url.searchParams.entries()].filter(([k]) => !ownedSearchKeys.has(k))
	: [];
const clearUrl = new URL(url);
for (const key of ownedSearchKeys) clearUrl.searchParams.delete(key);
const clearHref = `${clearUrl.pathname}${clearUrl.search}`;
const hasActiveSearch = Boolean(
	searchQuery && (searchQuery.text || searchQuery.month || searchQuery.year),
);
const grouped = view
	? [
			{
				key: view.viewSlug,
				title: view.mode === "past" ? "Past events" : "Upcoming events",
				events: searchQuery
					? filterEventsBySearch(baseViewEvents, searchQuery)
					: baseViewEvents,
			},
		]
	: [
			{
				key: "index-upcoming",
				title: "Upcoming events",
				events: sortEvents(events.filter((e) => e.period === "upcoming")),
			},
			{
				key: "index-past",
				title: "Past events",
				events: sortEvents(
					events.filter((e) => e.period === "past"),
					"desc",
				),
			},
			{
				key: "index-more",
				title: "More events",
				events: sortEvents(events.filter((e) => e.period === "preview")),
			},
		];
const groups = grouped.map((group) => {
	const page: EventPage | null = paginated
		? eventPage(group.events, group.key, url, perPage)
		: { events: group.events };
	const first = new URL(url);
	first.searchParams.delete(`events-page[${group.key}]`);
	return { ...group, page, first: `${first.pathname}${first.search}` };
});
---

<div
	class:list={[
		"event-list",
		`event-list--${view?.layout ?? "grid"}`,
		paginated && "event-list--contained",
	]}
>
	{
		view && searchBar && searchQuery && (
			<form
				method="get"
				action={url.pathname}
				class="event-search-form"
				role="search"
				aria-label={`Filter ${view.mode} events`}
			>
				{preservedParams.map(([k, v]) => (
					<input type="hidden" name={k} value={v} />
				))}
				{searchBar.text && (
					<label class="event-search-form__field">
						<span>Search</span>
						<input
							type="search"
							name={`events-q[${view.viewSlug}]`}
							value={searchQuery.text}
							placeholder="Search events…"
						/>
					</label>
				)}
				{searchBar.monthYear && (
					<>
						<label class="event-search-form__field">
							<span>Month</span>
							<select name={`events-month-num[${view.viewSlug}]`}>
								<option value="">All months</option>
								{months.map((m) => (
									<option value={m} selected={searchQuery.month === m}>
										{formatEventMonthName(m, locale)}
									</option>
								))}
							</select>
						</label>
						<label class="event-search-form__field">
							<span>Year</span>
							<select name={`events-year[${view.viewSlug}]`}>
								<option value="">All years</option>
								{availableYears.map((y) => (
									<option value={y} selected={searchQuery.year === y}>
										{y}
									</option>
								))}
							</select>
						</label>
					</>
				)}
				<button type="submit">Filter</button>
				{hasActiveSearch && (
					<a class="event-search-form__clear" href={clearHref}>
						Clear
					</a>
				)}
			</form>
		)
	}
	{
		navigation && (
			<nav aria-label={`Event months for ${view?.viewSlug}`}>
				{navigation.prev && (
					<a href={navigation.prev} rel="prev">
						Previous month
					</a>
				)}
				<strong>{formatEventMonth(navigation.month, locale)}</strong>
				{navigation.next && (
					<a href={navigation.next} rel="next">
						Next month
					</a>
				)}
			</nav>
		)
	}
	{
		tabUrls && (
			<nav class="event-view-tabs" aria-label="Calendar view">
				<a
					href={tabUrls.monthly}
					class:list={["event-view-tabs__tab", displayMode === "monthly" && "is-active"]}
					aria-current={displayMode === "monthly" ? "page" : undefined}
				>
					Monthly
				</a>
				<a
					href={tabUrls.list}
					class:list={["event-view-tabs__tab", displayMode === "list" && "is-active"]}
					aria-current={displayMode === "list" ? "page" : undefined}
				>
					List
				</a>
			</nav>
		)
	}
	{
		displayMode === "monthly" && monthlyNav ? (
			<section class="event-calendar">
				<nav class="event-month-nav" aria-label={`Calendar months for ${view?.viewSlug}`}>
					{monthlyNav.prev && (
						<a href={monthlyNav.prev} rel="prev">
							Previous month
						</a>
					)}
					<strong>{formatEventMonth(monthlyNav.month, locale)}</strong>
					{monthlyNav.next && (
						<a href={monthlyNav.next} rel="next">
							Next month
						</a>
					)}
				</nav>
				<table class="event-calendar-grid">
					<thead>
						<tr>
							<th scope="col">Sun</th>
							<th scope="col">Mon</th>
							<th scope="col">Tue</th>
							<th scope="col">Wed</th>
							<th scope="col">Thu</th>
							<th scope="col">Fri</th>
							<th scope="col">Sat</th>
						</tr>
					</thead>
					<tbody>
						{calendarWeeks.map((week) => (
							<tr>
								{week.map((cell) => (
									<td class:list={[!cell.inMonth && "is-outside"]}>
										<span class="event-calendar-grid__day">{cell.day}</span>
										{cell.events.length > 0 && (
											<ul class="event-calendar-grid__events">
												{cell.events.map((ev) => {
													const times = formatEventTimes(ev, locale);
													return (
														<li>
															<a href={`/events/${encodeURIComponent(ev.entry.id)}/`}>
																{eventString(ev.entry.data.title) ?? ev.entry.id}
															</a>
															{times && <span class="event-calendar-grid__time">{times}</span>}
														</li>
													);
												})}
											</ul>
										)}
									</td>
								))}
							</tr>
						))}
					</tbody>
				</table>
			</section>
		) : unavailable ? (
			<p>
				Event listing unavailable. The complete schedule could not be read.
				Please try again later.
			</p>
		) : (
			groups.map((group) => (
				<section>
					{!isMecHomeGrid && <h2>{group.title}</h2>}
					{group.page === null ? (
						<p>
							Event page unavailable. <a href={group.first}>View first page</a>.
						</p>
					) : group.page.events.length === 0 ? (
						<p>No {group.title.toLowerCase()} to show.</p>
					) : isListSkin ? (
						groupEventsByMonth(group.page.events).map((monthGroup) => (
							<div class="event-month-group">
								<h3 class="event-month-heading">
									{formatEventMonth(monthGroup.month, locale)}
								</h3>
								<ul>
									{monthGroup.events.map((event) => {
										const excerpt = eventExcerpt(event.entry);
										const href = `/events/${encodeURIComponent(event.entry.id)}/`;
										return (
											<li class="event-card">
												<EventCover image={event.entry.data.featured_image} />
												<div class="event-card__body">
													<h3>
														<a href={href}>
															{eventString(event.entry.data.title) ?? event.entry.id}
														</a>
													</h3>
													<EventFacts event={event} compact dateStyle={view?.dateStyle} />
													{excerpt && <p class="event-card__excerpt">{excerpt}</p>}
													{isUpcomingList && (
														<a class="event-card__detail" href={href}>
															View Detail
														</a>
													)}
												</div>
											</li>
										);
									})}
								</ul>
							</div>
						))
					) : (
						<ul>
							{group.page.events.map((event) => {
								const href = `/events/${encodeURIComponent(event.entry.id)}/`;
								return (
									<li class="event-card">
										<EventCover image={event.entry.data.featured_image} />
										<div class="event-card__body">
											{isMecHomeGrid && (
												<time class="event-card__date" datetime={event.date}>
													{formatEventMecFullDate(event.date, locale)}
												</time>
											)}
											<h3>
												<a href={href}>
													{eventString(event.entry.data.title) ?? event.entry.id}
												</a>
											</h3>
											<EventFacts
												event={event}
												compact
												dateStyle={view?.dateStyle}
												hideDate={isMecHomeGrid}
											/>
											{isMecHomeGrid && (
												<a class="event-card__detail" href={href}>
													View Detail
												</a>
											)}
										</div>
									</li>
								);
							})}
						</ul>
					)}
					{group.page && (group.page.prev || group.page.next) && (
						<nav
							class="pagination event-pagination"
							aria-label={`Event pages for ${group.key}`}
						>
							{group.page.prev && (
								<a href={group.page.prev} rel="prev">
									Previous events
								</a>
							)}
							{group.page.next && (
								<a href={group.page.next} rel="next">
									More events
								</a>
							)}
						</nav>
					)}
				</section>
			))
		)
	}
</div>
<style>
	.event-list {
		margin-block: 2rem;
	}
	.event-list--contained {
		box-sizing: border-box;
		width: 100%;
		max-width: var(
			--container-max-width,
			var(--wp--style--global--content-size, var(--max-width, 1140px))
		);
		margin-inline: auto;
		padding-inline: var(--spacing-6, 1.5rem);
	}
	.event-list ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.event-list .event-card {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		justify-content: flex-start;
		gap: 0.75rem;
		min-width: 0;
		margin: 0;
		padding: 0;
	}
	.event-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		flex: 1;
		min-width: 0;
		width: 100%;
	}
	.event-card h3 {
		margin: 0;
		font: inherit;
		font-size: 1.25em;
		font-weight: 600;
		line-height: 1.35;
		overflow-wrap: anywhere;
	}
	.event-card :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		margin: 0;
		object-fit: cover;
	}
	.event-list--grid ul,
	.event-list--tile ul {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: stretch;
		gap: 2rem;
	}
	.event-list--list .event-card {
		flex-direction: row;
		align-items: flex-start;
		gap: 1.5rem;
	}
	.event-list--list .event-card :global(img) {
		width: 15rem;
		max-width: 40%;
		flex: 0 0 15rem;
	}
	.event-list--list .event-card + .event-card {
		margin-top: 2rem;
	}
	.event-pagination {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-block-start: 1.5rem;
	}
	.event-search-form {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 0.75rem 1rem;
		margin-block-end: 1.5rem;
	}
	.event-search-form__field {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.9em;
	}
	.event-search-form__field input,
	.event-search-form__field select,
	.event-search-form button {
		font: inherit;
		padding: 0.4rem 0.65rem;
	}
	.event-search-form__clear {
		padding: 0.4rem 0.25rem;
	}
	.event-view-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-block-end: 1.5rem;
	}
	.event-view-tabs__tab {
		padding: 0.4rem 0.85rem;
		border: 1px solid currentColor;
		text-decoration: none;
	}
	.event-view-tabs__tab.is-active {
		font-weight: 600;
		text-decoration: underline;
	}
	.event-month-group + .event-month-group {
		margin-block-start: 2.5rem;
	}
	.event-month-heading {
		margin: 0 0 1rem;
		padding-bottom: 0.35rem;
		border-bottom: 1px solid currentColor;
		font-size: 1.15em;
		font-weight: 600;
	}
	.event-card__excerpt {
		margin: 0;
		line-height: 1.55;
	}
	.event-card__detail {
		align-self: flex-start;
		font-weight: 600;
	}
	.event-month-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-block-end: 1rem;
	}
	.event-calendar-grid {
		width: 100%;
		border-collapse: collapse;
		table-layout: fixed;
	}
	.event-calendar-grid th,
	.event-calendar-grid td {
		border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
		padding: 0.4rem;
		vertical-align: top;
	}
	.event-calendar-grid td {
		min-height: 5rem;
	}
	.event-calendar-grid td.is-outside {
		opacity: 0.45;
	}
	.event-calendar-grid__day {
		display: block;
		font-weight: 600;
		margin-bottom: 0.25rem;
	}
	.event-calendar-grid__events {
		font-size: 0.85em;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.event-calendar-grid__time {
		display: block;
		opacity: 0.75;
		font-size: 0.9em;
	}
	@media (max-width: 767px) {
		.event-list--list .event-card {
			flex-direction: column;
		}
		.event-list--list .event-card :global(img) {
			width: min(100%, 15rem);
			max-width: 100%;
			flex: none;
		}
		.event-list--grid ul,
		.event-list--tile ul {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
