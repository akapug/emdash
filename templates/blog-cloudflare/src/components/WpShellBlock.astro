---
/**
 * A paragraph, heading or quote in a migrated WordPress design
 * (layouts/WpShell.astro), drawn as EmDash's own block draws it
 * (packages/core/src/components/Block.astro), with one difference: a stored
 * left alignment is drawn too.
 *
 * EmDash's own block draws no class for left, its default. In WordPress a
 * left the classic editor wrote (`<p style="text-align: left;">`) is what
 * keeps a paragraph left where the theme aligns the region otherwise: Franz
 * Josef centres its front page's highlights. So every alignment is drawn
 * here as WordPress's own `has-text-align-{value}` class, and the rules for
 * them are in ../styles/wp-shell.css.
 *
 * A paragraph or heading of a page builder's widget carries the class the
 * builder draws on it (an Elementor heading's `elementor-heading-title`),
 * which ../utils/wp-skeleton.ts puts on the block as `skeletonClass` when it
 * draws the page in the builder's skeleton; only class characters are drawn.
 * A paragraph of a page's own layout that the page drew as a `<span>` or a
 * `<div>` (a list item's date) is drawn as that element, `skeletonTag`.
 */
import type { HTMLTag } from "astro/types";

interface Props {
	node: { style?: string; textAlign?: string; skeletonClass?: unknown; skeletonTag?: unknown };
	index?: number;
	isInline?: boolean;
}

const { node, index: _index, isInline: _isInline, ...attrs } = Astro.props;
const TAGS: Record<string, HTMLTag> = {
	h1: "h1",
	h2: "h2",
	h3: "h3",
	h4: "h4",
	h5: "h5",
	h6: "h6",
	blockquote: "blockquote",
};
// Allow-listed, so a stored value cannot put a class of its own on the page.
const ALIGN_CLASS: Record<string, string> = {
	left: "has-text-align-left",
	center: "has-text-align-center",
	right: "has-text-align-right",
	justify: "has-text-align-justify",
};
// A paragraph drawn as the page's own element: only a span or a div, and only a paragraph.
const AS: Record<string, HTMLTag> = { span: "span", div: "div" };
const own =
	(!node.style || node.style === "normal") &&
	typeof node.skeletonTag === "string" &&
	Object.hasOwn(AS, node.skeletonTag)
		? AS[node.skeletonTag]
		: undefined;
const Tag = own ?? (node.style && Object.hasOwn(TAGS, node.style) ? TAGS[node.style] : undefined) ?? "p";
const align = node.textAlign && Object.hasOwn(ALIGN_CLASS, node.textAlign) ? ALIGN_CLASS[node.textAlign] : undefined;
const CLASS_NAME = /^[A-Za-z0-9_-]{1,100}$/;
const builder =
	typeof node.skeletonClass === "string"
		? node.skeletonClass.split(/\s+/).filter((c) => CLASS_NAME.test(c))
		: [];
const cls = [...builder, ...(align ? [align] : [])].join(" ") || undefined;
---

<Tag class={cls} {...attrs}><slot /></Tag>
