---
import { PortableText } from "emdash/ui";
import type { ComponentProps } from "astro/types";
import BlogEmbed from "./BlogEmbed.astro";
import BlogImage from "./BlogImage.astro";
import PostsGrid from "./PostsGrid.astro";
type Props = ComponentProps<typeof PortableText>;
const { components, ...props } = Astro.props;
---

<PortableText
	{...props}
	components={{
		...components,
		type: { image: BlogImage, embed: BlogEmbed, "posts-grid": PostsGrid, ...components?.type },
	}}
/>
