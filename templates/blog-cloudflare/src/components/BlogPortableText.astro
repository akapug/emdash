---
import { PortableText } from "emdash/ui";
import type { ComponentProps } from "astro/types";
import BlogEmbed from "./BlogEmbed.astro";
type Props = ComponentProps<typeof PortableText>;
const { components, ...props } = Astro.props;
---

<PortableText
	{...props}
	components={{
		...components,
		type: { embed: BlogEmbed, ...components?.type },
	}}
/>
