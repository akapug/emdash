---
/**
 * The layout of a site migrated from WordPress: the site's own captured
 * header, footer and stylesheets (a shell record, see ../utils/wp-shell.ts),
 * with EmDash's content drawn inside WordPress's own content wrapper.
 *
 * Used only through the /wp-shell/ route, which the page routes rewrite to
 * when the site has a record. That route imports this layout and not
 * Base.astro, so none of Base's global CSS reaches the page: Astro bundles a
 * route's CSS from everything the route imports, rendered or not.
 *
 * What is drawn from EmDash, so an admin edit shows: the title and content
 * (with visual-editing markers), the menus (through each menu's own markup in
 * the theme), the site title, tagline and logo, and the title again where the
 * chrome prints it as text (a breadcrumb), and the entry's excerpt where the
 * source printed a subtitle beside its title. Everything else in the header and
 * footer is the captured markup, sanitized when it was captured. The home is
 * drawn from the record's home layout when it has one (the front page's own),
 * and a post from its post layout: its meta, featured image and share links
 * from the post's own values, and EmDash's comments inside the theme's
 * comment element. A date archive is drawn in the record's own layout, its
 * posts (`contentHtml`) in the content's place.
 *
 * Two of the chrome's controls are EmDash's own: WordPress's Archives widget
 * lists the months of EmDash's published posts (getPublishedDates), each a
 * link to its archive, and a sign-up for new posts by email posts to the
 * site's subscriptions plugin, its count line the plugin's confirmed count.
 */
import type { HTMLTag } from "astro/types";
import {
	getEditMeta,
	getEmDashCollection,
	getMenuWithCacheHint,
	getPublishedDates,
	getSiteSettingsWithCacheHint,
	getWidgetAreaWithCacheHint,
	sanitizeHref,
	type EditProxy,
	type PortableTextBlock,
	type WidgetArea,
} from "emdash";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "../styles/wp-shell.css";
import { PortableText } from "emdash/ui";
import WpShellBlock from "../components/WpShellBlock.astro";
import WpShellHtmlBlock from "../components/WpShellHtmlBlock.astro";
import WpShellWidgetHtmlBlock from "../components/WpShellWidgetHtmlBlock.astro";
import WpShellImage from "../components/WpShellImage.astro";
import WpShellLink from "../components/WpShellLink.astro";
import WpShellNote from "../components/WpShellNote.astro";
import WpShellEmbed from "../components/WpShellEmbed.astro";
import WpShellForm from "../components/WpShellForm.astro";
import PostsGrid from "../components/PostsGrid.astro";
import WpShellSkeleton from "../components/WpShellSkeleton.astro";
import SiteAnalytics from "../components/SiteAnalytics.astro";
import {
	bodyClassFor,
	composeWpShell,
	layoutFor,
	imageRatio,
	ownImagePath,
	plainText,
	popupsFor,
	stylesFor,
	type WpShell,
	type WpShellKind,
	type WpShellMenuItem,
	type WpShellPost,
	type WpShellPostFill,
	type WpShellSubscribeFill,
	wpShellDateSite,
	wpShellDocumentTitle,
} from "../utils/wp-shell";
import { hasSkeleton, skeletonTree } from "../utils/wp-skeleton";

interface Props {
	shell: WpShell;
	kind: WpShellKind;
	/** The path the visitor asked for (before the rewrite). */
	path: string;
	/** A page's slug (the home's page's, for the home): a page the record cut on its own is drawn in its own layout, and the record's `titles` name pages by it. */
	slug?: string | null;
	title: string;
	/** The entry's own SEO title, carried from WordPress: the document title, as written. */
	seoTitle?: string | null;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	/** The entry: its title, body and excerpt (a subtitle slot draws the excerpt), with its edit markers. */
	entry: { title: string; body?: PortableTextBlock[]; excerpt?: string | null; edit?: EditProxy };
	/** Markup drawn in the content's place instead of the entry's body: a date archive's posts. */
	contentHtml?: string;
	/** A single post's own values, for the record's post layout (its meta, featured image, share links). */
	post?: WpShellPostFill | null;
	/** Whether the page takes comments: without, the theme's comment element is not drawn. */
	comments?: boolean;
}

const {
	shell,
	kind,
	path,
	slug,
	title,
	seoTitle,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
	entry,
	contentHtml,
	post,
	comments = true,
} = Astro.props;

const locations = [...new Set(shell.menus.map((m) => m.location))];
const [settingsResult, ...menuResults] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	...locations.map((location) => getMenuWithCacheHint(location)),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	for (const m of menuResults) Astro.cache.set(m.cacheHint);
}
const settings = settingsResult.data;
const menus = new Map<string, readonly WpShellMenuItem[] | null>(
	locations.map((location, i) => [location, menuResults[i]?.data?.items ?? null]),
);

const siteTitle = settings.title ?? shell.parts.flatMap((p) => ("slot" in p && p.slot === "siteTitle" ? [p.fallback] : []))[0] ?? "";
const fullTitle = wpShellDocumentTitle(title, siteTitle, seoTitle);

const activePopups = popupsFor(shell, kind);
const layout = layoutFor(shell, kind, slug);

// The site's latest posts, where the layout lists them (the front page's highlights).
const listed = Math.max(
	0,
	...layout.parts.map((p) =>
		"slot" in p && p.slot === "listing" ? (shell.listings?.[p.listing]?.count ?? 0) : 0,
	),
);
const postsResult =
	listed > 0
		? await getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: listed })
		: null;
if (postsResult && Astro.cache?.enabled) Astro.cache.set(postsResult.cacheHint);
// The months the Archives widget lists, where the layout has one: the dates of the published posts alone.
const hasSlot = (slot: string) => layout.parts.some((p) => "slot" in p && p.slot === slot);
const datesResult = hasSlot("archives") ? await getPublishedDates("posts") : null;
if (datesResult && Astro.cache?.enabled) Astro.cache.set(datesResult.cacheHint);
if (datesResult?.error)
	console.warn(JSON.stringify({ event: "wp_shell_archives_dates", why: datesResult.error.message }));

// A sign-up posts to the subscriptions plugin; its count line is the plugin's count of confirmed
// subscribers. A site whose plugin does not answer takes no sign-ups, and draws none.
const SUBSCRIPTIONS = "emdash-subscriptions";
async function subscribeFill(): Promise<WpShellSubscribeFill | null> {
	const handle = getPublicPluginApiRouteHandler(Astro.locals);
	if (!handle) return null;
	try {
		const status = await handle(
			SUBSCRIPTIONS,
			"GET",
			"status",
			new Request(new URL(`/_emdash/api/plugins/${SUBSCRIPTIONS}/status`, Astro.url)),
		);
		const data = status.success ? (status.data as { confirmed?: unknown } | undefined) : undefined;
		if (!data) return null;
		return {
			action: `/_emdash/api/plugins/${SUBSCRIPTIONS}/subscribe`,
			source: path,
			status: Astro.url.searchParams.get("subscribe"),
			count: typeof data.confirmed === "number" ? data.confirmed : null,
		};
	} catch (error) {
		console.warn(
			JSON.stringify({ event: "wp_shell_subscribe", why: error instanceof Error ? error.message : String(error) }),
		);
		return null;
	}
}
const subscribe = hasSlot("subscribe") ? await subscribeFill() : null;

// Captured footer widget areas and copyright socket: once seeded in EmDash, the widget area
// is the truth (an emptied area draws nothing); before any seed (null), the captured fallback draws.
const widgetAreaNames = [
	...new Set(
		layout.parts.flatMap((p) => ("slot" in p && p.slot === "widgetArea" ? [p.area] : [])),
	),
];
const widgetAreaResults =
	widgetAreaNames.length > 0
		? await Promise.all(widgetAreaNames.map((name) => getWidgetAreaWithCacheHint(name)))
		: [];
if (Astro.cache?.enabled) {
	for (const r of widgetAreaResults) Astro.cache.set(r.cacheHint);
}
const widgetAreas = new Map<string, WidgetArea | null>(
	widgetAreaNames.map((name, i) => [name, widgetAreaResults[i]?.data ?? null]),
);
// Any menu widgets placed inside a footer widget area by the owner in Admin.
const widgetMenuNames = [
	...new Set(
		[...widgetAreas.values()].flatMap((area) =>
			(area?.widgets ?? []).flatMap((w) =>
				w.type === "menu" && w.menuName && !menus.has(w.menuName) ? [w.menuName] : [],
			),
		),
	),
];
if (widgetMenuNames.length > 0) {
	const extraMenus = await Promise.all(widgetMenuNames.map((name) => getMenuWithCacheHint(name)));
	for (let i = 0; i < widgetMenuNames.length; i++) {
		const m = extraMenus[i];
		if (m && Astro.cache?.enabled) Astro.cache.set(m.cacheHint);
		menus.set(widgetMenuNames[i]!, m?.data?.items ?? null);
	}
}

const posts: WpShellPost[] = (postsResult?.entries ?? []).map((e) => ({
	title: e.data.title,
	url: `/posts/${e.id}`,
	excerpt: e.data.excerpt,
	text: plainText(e.data.content),
	date: e.data.publishedAt,
	image: ownImagePath(e.data.featured_image),
	imageRatio: imageRatio(e.data.featured_image),
}));

const pieces = composeWpShell(shell, {
	siteTitle: settings.title,
	tagline: settings.tagline,
	logoUrl: settings.logo?.url,
	menuItems: (location) => menus.get(location),
	currentPath: path,
	kind,
	slug,
	title: entry.title,
	subtitle: entry.excerpt ?? null,
	posts,
	post,
	dates: datesResult?.dates ?? null,
	dateSite: wpShellDateSite(shell, settings.timezone),
	subscribe,
});
// EmDash's comments (the route's slot) go inside the theme's comment element where the layout has
// one (a post), and after the content otherwise.
const commentsInLayout = pieces.some((piece) => "comments" in piece);

// WordPress's own markup for what EmDash draws otherwise: a left alignment, an aligned image, a
// video embedded from a link in classic content, and a form imported from the site's form plugin,
// in that plugin's markup (EmDash's form, its submit path). A link of a page's own layout wears the
// class the page drew on it, and its hover texts are drawn as titles (../utils/wp-skeleton.ts).
const components = {
	block: WpShellBlock,
	// htmlBlock is overridden so a sign-up marker inside imported HTML becomes
	// the subscriptions plugin's own form (../components/WpShellHtmlBlock.astro).
	type: {
		image: WpShellImage,
		embed: WpShellEmbed,
		"emdash-form": WpShellForm,
		"posts-grid": PostsGrid,
		htmlBlock: WpShellHtmlBlock,
	},
	mark: { link: WpShellLink, wpShellNote: WpShellNote },
};
const widgetComponents = {
	...components,
	type: { ...components.type, htmlBlock: WpShellWidgetHtmlBlock },
};

// A page a builder made (Elementor) is drawn in the builder's own elements, which the page's own
// stylesheet and the site's rules select by (../utils/wp-skeleton.ts). While the owner edits the
// page in place, the body is EmDash's inline editor, as any other.
const skeleton =
	contentHtml === undefined && !getEditMeta(entry.body) && hasSkeleton(entry.body)
		? skeletonTree(entry.body as never)
		: null;

const pageCtx = createPublicPageContext({
	url: new URL(path + Astro.url.search, Astro.url.origin),
	locale: Astro.currentLocale,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});
---

<!doctype html>
<html
	lang={shell.html.lang ?? "en"}
	class={shell.html.class || undefined}
	data-wp-shell={shell.id}
>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		{stylesFor(shell, kind, slug).map((href) => <link rel="stylesheet" href={href} />)}
		<EmDashHead page={pageCtx} />
		{/* The captured chrome carries no script by design: the site's analytics come from its setting. */}
		<SiteAnalytics settings={settings} />
	</head>
	<body class={bodyClassFor(shell, kind, slug)}>
		<EmDashBodyStart page={pageCtx} />
		{
			pieces.map((piece) => {
				if ("html" in piece) return <Fragment set:html={piece.html} />;
				if ("widgetArea" in piece) {
					const area = widgetAreas.get(piece.widgetArea.area) ?? null;
					if (area === null) return <Fragment set:html={piece.widgetArea.fallback} />;
					if (area.widgets.length === 0) return null;
					return (
						<Fragment>
							{area.widgets.map((widget) => {
								if (widget.type === "content" && widget.content) {
									return (
										<Fragment>
											{widget.title && <h4 class="widget-title">{widget.title}</h4>}
											<PortableText value={widget.content} components={widgetComponents} />
										</Fragment>
									);
								}
								if (widget.type === "menu" && widget.menuName) {
									const items = menus.get(widget.menuName) ?? [];
									if (items.length === 0) return null;
									return (
										<Fragment>
											{widget.title && <h4 class="widget-title">{widget.title}</h4>}
											<ul class="menu">
												{items.map((item) => (
													<li>
														<a href={sanitizeHref(item.url)}>{item.label}</a>
													</li>
												))}
											</ul>
										</Fragment>
									);
								}
								return null;
							})}
						</Fragment>
					);
				}
				if ("comments" in piece) {
					if (!comments) return null;
					const Comments = piece.comments.tag as HTMLTag;
					return (
						<Comments class={piece.comments.class} id={piece.comments.id}>
							<slot />
						</Comments>
					);
				}
				if ("subtitle" in piece) {
					const Subtitle = piece.subtitle.tag as HTMLTag;
					return (
						<Subtitle class={piece.subtitle.class} id={piece.subtitle.id} {...entry.edit?.excerpt}>
							{entry.excerpt}
						</Subtitle>
					);
				}
				if ("title" in piece) {
					const Title = piece.title.tag as HTMLTag;
					return (
						<Title class={piece.title.class} id={piece.title.id} {...entry.edit?.title}>
							{entry.title}
						</Title>
					);
				}
				const Content = piece.content.tag as HTMLTag;
				return (
					<Fragment>
						<Content class={piece.content.class} id={piece.content.id} {...entry.edit?.content}>
							{Astro.slots.has("content") ? (
								<slot name="content" />
							) : contentHtml !== undefined ? (
								<Fragment set:html={contentHtml} />
							) : skeleton ? (
								<WpShellSkeleton nodes={skeleton} components={components} />
							) : (
								<PortableText value={entry.body} components={components} />
							)}
							{piece.end && <Fragment set:html={piece.end} />}
						</Content>
						{!commentsInLayout && <slot />}
					</Fragment>
				);
			})
		}
		{
			activePopups.map((popup) => (
				<dialog
					id={`wp-shell-popup-${popup.id}`}
					class="wp-shell-popup"
					aria-label={popup.title || "Announcement"}
					data-wp-shell-popup={popup.id}
					data-wp-shell-triggers={JSON.stringify(popup.triggers)}
					data-wp-shell-close-overlay={popup.closeOnOverlay ? "1" : "0"}
					data-wp-shell-close-esc={popup.closeOnEsc === false ? "0" : "1"}
				>
					<div class="wp-shell-popup-inner">
						<button
							type="button"
							class="wp-shell-popup-close"
							data-wp-shell-popup-close
							aria-label={popup.closeLabel || "Close"}
						>
							{popup.closeLabel || "Close"}
						</button>
						<div class="wp-shell-popup-content" set:html={popup.html} />
					</div>
				</dialog>
			))
		}
		{
			activePopups.length > 0 && (
				<script is:inline>
					{`(() => {
  const dialogs = document.querySelectorAll("dialog[data-wp-shell-popup]");
  for (const dialog of dialogs) {
    if (!(dialog instanceof HTMLDialogElement)) continue;
    const id = dialog.getAttribute("data-wp-shell-popup") || "";
    let triggers = [];
    try { triggers = JSON.parse(dialog.getAttribute("data-wp-shell-triggers") || "[]"); } catch { continue; }
    const storageKey = "wp-shell-popup-dismissed:" + (triggers.find((t) => t && t.cookieName)?.cookieName || id);
    const isDismissed = () => { try { return sessionStorage.getItem(storageKey) === "1"; } catch { return false; } };
    const dismiss = () => {
      try { sessionStorage.setItem(storageKey, "1"); } catch {}
      if (dialog.open) dialog.close();
    };
    const open = () => { if (!dialog.open) dialog.showModal(); };
    dialog.addEventListener("click", (e) => {
      const target = e.target;
      if (target instanceof Element && target.closest("[data-wp-shell-popup-close], .pum-close, .popmake-close")) {
        e.preventDefault();
        dismiss();
        return;
      }
      if (target === dialog && dialog.getAttribute("data-wp-shell-close-overlay") === "1") dismiss();
    });
    dialog.addEventListener("cancel", (e) => {
      if (dialog.getAttribute("data-wp-shell-close-esc") === "0") { e.preventDefault(); return; }
      try { sessionStorage.setItem(storageKey, "1"); } catch {}
    });
    for (const t of triggers) {
      if (!t || typeof t !== "object") continue;
      if (t.type === "auto_open") {
        const delay = typeof t.delayMs === "number" && t.delayMs >= 0 ? t.delayMs : 0;
        window.setTimeout(() => { if (!isDismissed()) open(); }, delay);
      } else if (t.type === "click_open") {
        const sels = Array.isArray(t.selectors) && t.selectors.length > 0 ? t.selectors : [".popmake-" + id, 'a[href="#popmake-' + id + '"]'];
        const joined = sels.join(", ");
        document.addEventListener("click", (e) => {
          const target = e.target;
          if (target instanceof Element && !dialog.contains(target) && target.closest(joined)) {
            e.preventDefault();
            open();
          }
        });
      } else if (t.type === "exit_intent") {
        document.addEventListener("mouseleave", (e) => {
          if (e.clientY <= 0 && !isDismissed()) open();
        }, { once: true });
      }
    }
  }
})();`}
				</script>
			)
		}
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
