{
	"name": "@emdash-cms/plugin-subscriptions",
	"version": "0.1.0",
	"private": true,
	"description": "Email subscriptions to a site's new posts for EmDash CMS: a no-script sign-up form, double opt-in, and new-post emails through the site's email",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./astro": "./src/astro/index.ts",
		"./ui": "./src/astro/ui.ts"
	},
	"files": [
		"src"
	],
	"keywords": [
		"emdash",
		"cms",
		"plugin",
		"subscriptions",
		"newsletter"
	],
	"license": "MIT",
	"peerDependencies": {
		"astro": ">=6.0.0-beta.0",
		"emdash": "workspace:>=0.11.0"
	},
	"devDependencies": {
		"astro": "catalog:",
		"vitest": "catalog:"
	},
	"scripts": {
		"test": "vitest run && vitest run --config vitest.render.config.ts",
		"typecheck": "tsgo --noEmit"
	}
}
