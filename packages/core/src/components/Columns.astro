---
/**
 * Portable Text Columns block component
 *
 * Renders multi-column layouts from WordPress imports.
 */
import { nestedRenderOf } from "./portable-text-nested.js";

export interface Props {
	node: {
		_type: "columns";
		_key: string;
		columns: Array<{
			_type: "column";
			_key: string;
			content: unknown[];
			width?: string;
		}>;
	};
}

const { node } = Astro.props;
const columns = node?.columns ?? [];

if (!columns.length) {
	return null;
}

// Each column is drawn with EmDash's own PortableText and the components the
// page drew this block with (portable-text-nested.ts), so an image, a gallery,
// an embed or a nested columns block in a column renders. Imported when drawn:
// PortableText.astro imports index.ts, which imports this component.
const { default: PortableText } = await import("./PortableText.astro");
const nested = nestedRenderOf(node);
---

<div class="emdash-columns" style={`--column-count: ${columns.length}`}>
	{
		columns.map((column) => (
			<div
				class="emdash-column"
				style={column.width ? `flex-basis: ${column.width}` : undefined}
			>
				<PortableText value={column.content} {...nested} />
			</div>
		))
	}
</div>

<style>
	.emdash-columns {
		display: flex;
		gap: 2rem;
		margin: 1.5rem 0;
	}
	.emdash-column {
		flex: 1;
		min-width: 0;
	}
	@media (max-width: 768px) {
		.emdash-columns {
			flex-direction: column;
			gap: 1rem;
		}
	}
</style>
