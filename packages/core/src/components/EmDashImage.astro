---
/**
 * EmDash Image component
 *
 * Renders images with responsive srcset for CDN providers that support it.
 * Uses the provider's getSrc function for URL-based image transformations.
 *
 * Usage:
 * ```astro
 * ---
 * import { Image } from "emdash/ui";
 * ---
 * <Image image={post.data.featured_image} />
 *
 * <!-- With overrides -->
 * <Image image={post.data.featured_image} class="hero" />
 * ```
 *
 * When the image value carries a `darkVariant`, both images are rendered and
 * CSS shows the one matching the page's color scheme. See the dark mode guide
 * for the `<html>` class convention and how to override the selectors.
 */
import type { ImageValue, MediaValue } from "../fields/types.js";
import type { HTMLAttributes } from "astro/types";
import { Image as AstroImage, getImage } from "astro:assets";
import type { ImageEmbed } from "../media/types.js";
import { getMediaProvider } from "../media/provider-loader.js";
import { normalizeLegacyExternalMediaValue } from "../media/normalize.js";
import { buildRenderMediaUrl } from "../media/url.js";
import {
	buildResponsiveImage,
	lazyAutoSizes,
	responsiveSizes,
	toAbsoluteMediaUrl,
	RESPONSIVE_BREAKPOINTS,
} from "../media/responsive.js";
import { getPublicOrigin } from "../api/public-url.js";
import { focalPointToObjectPosition } from "../media/focal-point.js";
import { storedSizesForRender } from "../media/variant-read.js";

interface Props extends Omit<
	HTMLAttributes<"img">,
	"src" | "width" | "height"
> {
	/** Image value from content field or media library */
	image: ImageValue | string | undefined | null;
	/**
	 * Image shown in a dark color scheme. Defaults to `image.darkVariant`;
	 * pass it explicitly when the dark image comes from another field.
	 */
	darkVariant?: MediaValue | string | undefined | null;
	/** Override alt text (uses image.alt by default) */
	alt?: string;
	/** Override width (uses image.width by default) */
	width?: number;
	/** Override height (uses image.height by default) */
	height?: number;
	/** Priority loading (disables lazy loading) */
	priority?: boolean;
	/** Render the LQIP placeholder as an inline background. Disable for strict CSP. */
	placeholder?: boolean;
	/** Use only committed variants; without them, render the source as a plain image. */
	storedSizesOnly?: boolean;
}

const {
	image,
	darkVariant,
	alt,
	width,
	height,
	priority,
	placeholder = true,
	storedSizesOnly = false,
	class: className,
	id,
	...attrs
} = Astro.props;

// Normalize string URLs to object form
function normalizeImage(
	img: MediaValue | string | undefined | null
): MediaValue | null {
	if (!img) return null;
	if (typeof img === "string") {
		return { id: "", src: img };
	}
	return normalizeLegacyExternalMediaValue(img);
}

/**
 * Build the URL for a local image. Prefers `meta.storageKey`; falls back to
 * the internal proxy with `img.id` when no storage key is available.
 */
function buildLocalImageUrl(img: MediaValue): string {
	return buildRenderMediaUrl(Astro.locals.emdash?.getPublicMediaUrl, {
		storageKey: img.meta?.storageKey as string | undefined,
		id: img.id,
	});
}

/**
 * Generate a srcset from a provider's `getSrc`, or NOTHING when the list cannot be backed.
 *
 * A SRCSET IS A PROMISE, AND A FALSE ONE COSTS THE MOST. This function asks the provider for the same picture at
 * several widths. When the provider CANNOT resize — a media provider that answers the same storage URL whatever
 * width it is asked for — every entry comes back identical, and the markup then reads `640w … 5400w` all pointing at
 * one multi-megabyte original. With `sizes="100vw"` the browser believes it and downloads the whole original at
 * every viewport: measured on a real site, a page whose images were 0.48 MB on the source served 5.85 MB.
 *
 * The same rule the stored-sizes branch already states — "a fixed ladder would promise 300w over a multi-megabyte
 * original, which is worse than no srcset because the browser believes it" — applies wherever a srcset is built,
 * not only where stored sizes are. So: if the entries are not DISTINCT, emit no srcset at all. One `src` and no list
 * is the honest markup; a list of one URL pretending to be many is not.
 *
 * Distinctness is compared on the resolved URL only, because that is the thing the browser fetches. A provider that
 * answers different URLs is trusted; one that answers the same URL has not resized anything.
 */
function generateSrcset(
	getSrc: NonNullable<ImageEmbed["getSrc"]>,
	maxWidth: number,
	aspectRatio?: number
): string | undefined {
	const entries = RESPONSIVE_BREAKPOINTS.filter((w) => w <= maxWidth * 2) // Include up to 2x for retina
		.map((w) => {
			const h = aspectRatio ? Math.round(w / aspectRatio) : undefined;
			return { url: getSrc({ width: w, height: h }), w };
		});
	if (entries.length < 2) return undefined;
	const distinct = new Set(entries.map((entry) => entry.url));
	if (distinct.size < 2) return undefined;
	return entries.map((entry) => `${entry.url} ${entry.w}w`).join(", ");
}

interface ResolvedImage {
	src: string;
	srcset?: string;
	sizes?: string;
	hasWidthSrcset: boolean;
	media: MediaValue;
	astroImageSrc: string;
	width?: number;
	height?: number;
	generatedStyle: string;
}

/**
 * Resolve the source URL, srcset, dimensions, and LQIP style for one media
 * value. Props override the value's own dimensions.
 */
async function resolveImage(img: MediaValue): Promise<ResolvedImage> {
	const finalWidth = width ?? img.width;
	const finalHeight = height ?? img.height;
	const aspectRatio =
		finalWidth && finalHeight ? finalWidth / finalHeight : undefined;

	let src = "";
	let srcset: string | undefined;
	let sizes: string | undefined;
	let hasWidthSrcset = false;
	let astroImageSrc = "";

	const providerId = img.provider ?? "local";

	if (storedSizesOnly || providerId === "local" || img.src) {
		src = img.src || buildLocalImageUrl(img);
		const publicOrigin = getPublicOrigin(Astro.url, Astro.locals.emdash?.config);
		const absoluteSrc = toAbsoluteMediaUrl(src, publicOrigin);
		// ASTRO'S <Image> THROWS MissingImageDimension ON A REMOTE SRC WITHOUT BOTH DIMENSIONS, so `useAstroImage`
		// already requires them. A caller that passes neither — a card, before it was given the row's size — falls to
		// a plain <img> with the original, which is the honest markup rather than a page that fails to render.
		const useAstroImage = finalWidth && finalHeight && absoluteSrc.startsWith(`${publicOrigin}/`);
		if (storedSizesOnly || useAstroImage) {
			// Offer only the widths that are stored. A fixed ladder would promise 300w over
			// a multi-megabyte original, which is worse than no srcset because the browser
			// believes it. Nothing stored leaves the markup exactly as it was.
			const stored = await storedSizesForRender(
				{
					storageKey: !storedSizesOnly || providerId === "local"
						? ("storageKey" in img && typeof img.storageKey === "string"
							? img.storageKey
							: img.meta?.storageKey as string | undefined)
						: undefined,
					url: src,
					origin: publicOrigin,
				},
				finalWidth,
			);
			// DIMENSIONS THE CALLER GAVE, OR NONE AT ALL.
			//
			// Astro's <Image> refuses a remote src with no width and height ("both dimensions are required in order to
			// avoid CLS"), so a card that passes neither cannot go through it. The dimensions are NOT taken from the
			// stored variants here: those arms belong to every component sharing that read, and several pin the
			// rendered markup they get today. Without dimensions this stays a plain <img> with the original, which the
			// card path already renders correctly.
			astroImageSrc = finalWidth && finalHeight ? absoluteSrc : "";
			if (stored) {
				srcset = stored.srcset;
				hasWidthSrcset = true;
				sizes = responsiveSizes(storedSizesOnly ? stored.bound : finalWidth);
			} else if (!storedSizesOnly) {
				astroImageSrc = absoluteSrc;
			}
		} else {
			const optimized = await buildResponsiveImage(getImage, {
				src: absoluteSrc,
				width: finalWidth,
				height: finalHeight,
			});
			if (optimized) {
				src = optimized.src;
				srcset = optimized.srcset;
				// A configured image service can return no candidates or density descriptors.
				hasWidthSrcset =
					srcset?.split(", ").every((candidate) => /^\S+ [1-9]\d*w$/.test(candidate)) ?? false;
				sizes = optimized.sizes;
			}
		}
	} else {
		// External provider
		try {
			const provider = await getMediaProvider(providerId);
			if (provider) {
				const result = provider.getEmbed(img, {
					width: finalWidth,
					height: finalHeight,
				});
				const embed = result instanceof Promise ? await result : result;
				if (embed.type === "image") {
					src = embed.src;

					// Generate srcset if provider supports dynamic sizing
					if (embed.getSrc) {
						// Use image width, or default to 1200 for responsive images
						const maxWidth = finalWidth || 1200;
						// `sizes` IS ONLY MEANINGFUL BESIDE A SRCSET, and it is what makes a false one expensive: with
						// `sizes="100vw"` the browser picks the largest candidate for a full-width slot. No list, no
						// `sizes` — the original is drawn once and the markup claims nothing it cannot back.
						srcset = generateSrcset(embed.getSrc, maxWidth, aspectRatio);
						hasWidthSrcset = Boolean(srcset);
						// `sizes` IS ONLY MEANINGFUL BESIDE A SRCSET, and a false one is what makes an unbackable list
						// expensive: with `sizes="100vw"` the browser prefers the largest candidate, and when every
						// candidate is the same URL that is the whole original at every viewport. No list, no `sizes`.
						sizes = srcset
							? finalWidth
								? `(min-width: ${finalWidth}px) ${finalWidth}px, 100vw`
								: "100vw"
							: undefined;
					}
				}
			} else {
				console.warn(`[EmDashImage] Provider not found: ${providerId}`);
			}
		} catch (error) {
			console.error(
				`[EmDashImage] Failed to get embed for image ${img.id}:`,
				error
			);
		}

		// Fallback to local URL if provider failed
		if (!src) {
			src = buildLocalImageUrl(img);
		}
	}

	// Build placeholder background style. Prefer the first-class MediaValue fields;
	// fall back to `meta` for snapshots stored before LQIP was promoted off `meta`.
	const blurhash = img.blurhash ?? (img.meta?.blurhash as string | undefined);
	const dominantColor =
		img.dominantColor ?? (img.meta?.dominantColor as string | undefined);

	let placeholderStyle = "";
	if (placeholder && blurhash) {
		const { blurhashToImageCssString } = await import("@unpic/placeholder");
		placeholderStyle = blurhashToImageCssString(blurhash);
	} else if (placeholder && dominantColor) {
		placeholderStyle = `background-color: ${dominantColor};`;
	}

	// The focal point travels with the media value, so the dark variant gets
	// its own object-position rather than inheriting the light image's.
	const objectPosition = focalPointToObjectPosition(img.focalX, img.focalY);
	const generatedStyle = [
		placeholderStyle,
		objectPosition ? `object-position: ${objectPosition};` : "",
	]
		.filter(Boolean)
		.join(" ");

	return {
		src,
		srcset,
		sizes,
		hasWidthSrcset,
		media: img,
		astroImageSrc,
		width: finalWidth,
		height: finalHeight,
		generatedStyle,
	};
}

const img = normalizeImage(image);
const darkSource =
	darkVariant ?? (typeof image === "object" ? image?.darkVariant : undefined);
const dark = img ? normalizeImage(darkSource) : null;
const finalAlt = alt ?? img?.alt ?? "";

const resolved = img ? await resolveImage(img) : null;
const resolvedDark = dark ? await resolveImage(dark) : null;

function imgProps(
	r: ResolvedImage,
	variantClass: string | undefined,
	elementId: string | null | undefined
): Record<string, unknown> {
	const props = {
		id: elementId,
		src: r.src,
		srcset: r.srcset,
		sizes: r.sizes,
		width: r.width,
		height: r.height,
		alt: finalAlt,
		loading: priority ? "eager" : "lazy",
		fetchpriority: priority ? "high" : undefined,
		decoding: "async",
		style: r.generatedStyle || undefined,
		class: ["emdash-image-media", variantClass, className].filter(Boolean).join(" "),
		...attrs,
	};
	// Passthrough can override loading and the source list; only opt in our own candidates.
	const highPriority =
		typeof props.fetchpriority === "string" && props.fetchpriority.toLowerCase() === "high";
	if (
		!priority &&
		!highPriority &&
		!Object.hasOwn(attrs, "sizes") &&
		!Object.hasOwn(attrs, "srcset") &&
		!Object.hasOwn(attrs, "src")
	) {
		props.sizes = lazyAutoSizes(r.sizes, {
			loading: props.loading,
			hasWidthSrcset: r.hasWidthSrcset && Boolean(props.srcset),
			width: props.width,
			height: props.height,
			sources: [
				props.src,
				r.media.src,
				r.media.filename,
				r.media.storageKey,
				r.media.meta?.storageKey,
			],
			mimeType: r.media.mimeType ?? r.media.meta?.mimeType,
		});
	}
	return props;
}

const lightClass = resolvedDark ? "emdash-image--light" : undefined;
// Both variants render into the same document, so a caller-supplied `id` would
// otherwise appear on two elements.
const darkId = id ? `${id}--dark` : undefined;
const astroClass = (variantClass: string | undefined) =>
	[variantClass, className].filter(Boolean).join(" ") || undefined;
---

{
	resolved && resolved.astroImageSrc ? (
		<AstroImage
			id={id}
			src={resolved.astroImageSrc}
			alt={finalAlt}
			width={resolved.width}
			height={resolved.height}
			priority={priority}
			layout="constrained"
			loading={priority ? "eager" : "lazy"}
			decoding="async"
			class={astroClass(lightClass)}
			style={resolved.generatedStyle || undefined}
			{...attrs}
		/>
	) : resolved && resolved.src ? (
		<img {...imgProps(resolved, lightClass, id)} />
	) : null
}
{
	resolvedDark && resolvedDark.astroImageSrc ? (
		<AstroImage
			id={darkId}
			src={resolvedDark.astroImageSrc}
			alt={finalAlt}
			width={resolvedDark.width}
			height={resolvedDark.height}
			priority={priority}
			layout="constrained"
			loading={priority ? "eager" : "lazy"}
			decoding="async"
			class={astroClass("emdash-image--dark")}
			style={resolvedDark.generatedStyle || undefined}
			{...attrs}
		/>
	) : resolvedDark && resolvedDark.src ? (
		<img {...imgProps(resolvedDark, "emdash-image--dark", darkId)} />
	) : null
}

<style>
	.emdash-image-media {
		max-width: 100%;
		height: auto;
	}
</style>

<style is:global>
	/* A `dark` or `light` class on <html> wins over the system preference. */
	:where(:root.dark) .emdash-image--light {
		display: none;
	}
	:where(:root.light) .emdash-image--dark {
		display: none;
	}
	@media (prefers-color-scheme: dark) {
		:where(:root:not(.light)) .emdash-image--light {
			display: none;
		}
	}
	@media (prefers-color-scheme: light) {
		:where(:root:not(.dark)) .emdash-image--dark {
			display: none;
		}
	}
</style>
