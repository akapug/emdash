---
/**
 * Portable Text Image block component
 *
 * Renders image blocks from WordPress imports and EmDash media.
 * Uses the provider's getSrc function for responsive srcset generation.
 */
import { Image as AstroImage } from "astro:assets";
import type { ImageEmbed } from "../media/types.js";
import { getMediaProvider } from "../media/provider-loader.js";
import { buildRenderMediaUrl } from "../media/url.js";
import {
	lazyAutoSizes,
	responsiveSizes,
	toAbsoluteMediaUrl,
	RESPONSIVE_BREAKPOINTS,
} from "../media/responsive.js";
import { storedSizesForRender } from "../media/variant-read.js";
import { getPublicOrigin } from "../api/public-url.js";
import { sanitizeHref } from "../utils/url.js";
import { normalizeImageLink } from "../content/converters/image-link.js";
import { resolveImageMedia } from "../content/converters/gallery.js";

export interface Props {
	node: {
		_type: "image";
		_key: string;
		asset: {
			_ref: string;
			url?: string;
			mimeType?: string;
			/** Provider ID for external media (e.g., "cloudflare-images") */
			provider?: string;
			/** Provider metadata. LQIP is read from first-class fields below;
			 *  `meta` only remains as a fallback for legacy snapshots. */
			meta?: Record<string, unknown>;
		};
		alt?: string;
		caption?: string;
		/** Original image width */
		width?: number;
		/** Original image height */
		height?: number;
		/** LQIP blurhash — first-class field (legacy snapshots store it in `asset.meta`). */
		blurhash?: string;
		/** LQIP dominant color — first-class field (legacy snapshots store it in `asset.meta`). */
		dominantColor?: string;
		/** Display width for this instance (overrides original) */
		displayWidth?: number;
		/** Display height for this instance (overrides original) */
		displayHeight?: number;
		/** Alignment for this image instance (e.g. from a WordPress import) */
		alignment?: "left" | "center" | "right" | "wide" | "full";
		/**
		 * Optional link. When set, the image is rendered inside an `<a>` using
		 * `sanitizeHref`-validated `href`. A bare string is the legacy shape
		 * written by WordPress/Gutenberg imports.
		 */
		link?: string | { href: string; blank?: boolean };
	};
	/** Render the LQIP placeholder as an inline background. Disable for strict CSP. */
	placeholder?: boolean;
}

/**
 * Generate srcset using provider's getSrc function
 */
function generateSrcset(
	getSrc: NonNullable<ImageEmbed["getSrc"]>,
	maxWidth: number,
	aspectRatio?: number,
): string {
	return RESPONSIVE_BREAKPOINTS.filter((w) => w <= maxWidth * 2)
		.map((w) => {
			const h = aspectRatio ? Math.round(w / aspectRatio) : undefined;
			return `${getSrc({ width: w, height: h })} ${w}w`;
		})
		.join(", ");
}

const { node, placeholder = true } = Astro.props;

if (!node?.asset) {
	return null;
}

const { caption, displayWidth, displayHeight, alignment, link } = node;
const { asset, alt = "", width, height } = resolveImageMedia(node);

const imageLink = normalizeImageLink(link);
const linkHref = imageLink ? sanitizeHref(imageLink.href) : null;
// Same-page anchor links (`#section`) are on-page jumps — never open them in
// a new tab, regardless of `blank`. Mirrors marks/Link.astro.
const isSamePageAnchor = linkHref?.startsWith("#") ?? false;
const linkBlank = !isSamePageAnchor && imageLink?.blank === true;
const linkTarget = linkBlank ? "_blank" : undefined;
const linkRel = linkBlank ? "noopener noreferrer" : undefined;

// Calculate aspect ratio from original dimensions
const aspectRatio = width && height ? width / height : undefined;

// Calculate render dimensions
let renderWidth: number | undefined;
let renderHeight: number | undefined;

if (displayWidth && displayHeight) {
	renderWidth = displayWidth;
	renderHeight = displayHeight;
} else if (displayWidth && aspectRatio) {
	renderWidth = displayWidth;
	renderHeight = Math.round(displayWidth / aspectRatio);
} else if (displayHeight && aspectRatio) {
	renderWidth = Math.round(displayHeight * aspectRatio);
	renderHeight = displayHeight;
} else {
	renderWidth = width;
	renderHeight = height;
}

// Get the image source URL and srcset
let src = "";
let srcset: string | undefined;
let sizes: string | undefined;
let astroImageSrc = "";
// The width the STORED candidates stop at: a reserved box the browser can lay out, even when the block carries no
// dimensions of its own (see `lazyAutoSizes` below).
let storedBound: number | undefined;
let storedShape: number | undefined;
const providerId = asset.provider;

if (providerId && providerId !== "local") {
	// External provider
	const provider = await getMediaProvider(providerId);
	if (provider) {
		try {
			const mediaValue = {
				provider: providerId,
				id: asset._ref,
				width: renderWidth,
				height: renderHeight,
				alt,
			};
			const result = provider.getEmbed(mediaValue, {
				width: renderWidth,
				height: renderHeight,
			});
			const embed = result instanceof Promise ? await result : result;
			if (embed.type === "image") {
				src = embed.src;

				// Generate srcset if provider supports dynamic sizing
				if (embed.getSrc) {
					const maxWidth = renderWidth || 1200;
					const ar = renderWidth && renderHeight ? renderWidth / renderHeight : aspectRatio;
					srcset = generateSrcset(embed.getSrc, maxWidth, ar);
					sizes = renderWidth
						? `(min-width: ${renderWidth}px) ${renderWidth}px, 100vw`
						: "100vw";
				}
			}
		} catch (error) {
			console.warn(`Failed to get embed for image ${asset._ref}:`, error);
		}
	}
}

// Fallback for local provider. `asset.url` carries the storage key with
// extension when present; `asset._ref` is a bare ULID that only the internal
// `/file/{id}` route can resolve. `buildRenderMediaUrl` picks the right shape.
if (!src) {
	src = buildRenderMediaUrl(Astro.locals.emdash?.getPublicMediaUrl, {
		url: asset.url,
		id: asset._ref,
	});
	if (renderWidth && renderHeight) {
		astroImageSrc = toAbsoluteMediaUrl(src, getPublicOrigin(Astro.url, Astro.locals.emdash?.config));
	}
	// Offer the widths that are stored for this image, named by what the block holds
	// and not by `src`, which is a CDN address when a public bucket is configured. An
	// imported block often carries no dimensions; the bound is then the original's
	// upright width.
	//
	// The original may close the list only when an editor set a display width, so the
	// slot is known. Without one, `sizes` names the original's width and not the column
	// the image sits in, and offering the original would fetch it for a small slot.
	// A STORED LIST IS ITS OWN RESERVED BOX. `stored.bound` is the width the stored candidates stop at, which is exactly
	// what the browser needs to lay the image out — but `renderWidth` can be undefined here (an imported block often
	// carries no dimensions), and `lazyAutoSizes` refuses to say `auto, …` without a box. Measured on a real home page:
	// four image blocks inside columns got `(min-width: 3024px) 3024px, 100vw` and fetched ?w=1536 for a column slot,
	// 4.5 MB of a 7.45 MB page — while the two images whose blocks DO carry dimensions got `auto, …` and were fine.
	const stored = await storedSizesForRender(
		{ url: asset.url, origin: getPublicOrigin(Astro.url, Astro.locals.emdash?.config) },
		renderWidth,
		{ offerOriginal: typeof displayWidth === "number" && displayWidth > 0 },
	);
	if (stored) {
		// <AstroImage> takes `src` alone and derives a srcset of its own.
		astroImageSrc = "";
		srcset = stored.srcset;
		sizes = responsiveSizes(stored.bound);
		storedBound = stored.bound;
		storedShape = stored.shape;
	}
}

// Both plain <img> branches use only stored or provider-generated width candidates.
const imgLoading = "lazy";
/** Height implied by the stored bound and the media's own shape, when the node gives none. */
const derivedHeight =
	renderHeight ??
	(renderWidth !== undefined && storedShape
		? Math.max(1, Math.round(renderWidth / storedShape))
		: storedBound !== undefined && storedShape
			? Math.max(1, Math.round(storedBound / storedShape))
			: undefined);
const effectiveWidth = renderWidth ?? storedBound;
const effectiveHeight = renderHeight ?? derivedHeight;
const imgSizes = lazyAutoSizes(sizes, {
	loading: imgLoading,
	hasWidthSrcset: Boolean(srcset),
	// THE STORED BOUND IS A RESERVED BOX. An imported block often carries no dimensions, so `renderWidth` is undefined
	// even though the server knows exactly which widths this image has — and `lazyAutoSizes` refuses `auto, …` without a
	// box. Measured on a real home page: four image blocks inside columns got `(min-width: 3024px) 3024px, 100vw` and
	// fetched ?w=1536 for a column slot — 4.5 MB of a 7.45 MB page — while the two blocks carrying dimensions got
	// `auto, …` and were fine. The bound says the same thing the dimensions would, so it counts.
	// BOTH DIMENSIONS, BECAUSE `auto` NEEDS A REAL BOX. `sizes="auto"` asks the browser for the LAID-OUT width, and a
	// lazy image with no `height` lays out 0 tall until it loads — so the browser takes the smallest candidate and the
	// picture arrives blurry. The stored bound gives the width and `shape` (width/height) gives the height, so the box
	// is reserved before load and nothing shifts.
	width: renderWidth ?? storedBound,
	height: renderHeight ?? derivedHeight,
	hasReservedBox: effectiveWidth !== undefined && effectiveHeight !== undefined,
	sources: [src, asset.url, asset._ref, node.asset.meta?.storageKey],
	mimeType: node.asset.mimeType ?? node.asset.meta?.mimeType,
});

// Build placeholder background style. Prefer first-class LQIP fields; fall
// back to `asset.meta` for legacy snapshots persisted before LQIP was promoted.
const blurhash = (node.blurhash ?? (node.asset.meta?.blurhash as string | undefined)) as
	| string
	| undefined;
const dominantColor = (node.dominantColor ??
	(node.asset.meta?.dominantColor as string | undefined)) as string | undefined;

let placeholderStyle = "";
if (placeholder && blurhash) {
	const { blurhashToImageCssString } = await import("@unpic/placeholder");
	placeholderStyle = blurhashToImageCssString(blurhash);
} else if (placeholder && dominantColor) {
	placeholderStyle = `background-color: ${dominantColor};`;
}

---

<figure class:list={["emdash-image", alignment && `emdash-image--align-${alignment}`]}>
	{
		linkHref ? (
			<a href={linkHref} target={linkTarget} rel={linkRel}>
				{astroImageSrc ? (
					<AstroImage
						src={astroImageSrc}
						alt={alt}
						width={renderWidth}
						height={renderHeight}
						layout="constrained"
						loading="lazy"
						decoding="async"
						style={placeholderStyle || undefined}
					/>
				) : (
					<img
						src={src}
						srcset={srcset}
						sizes={imgSizes}
						alt={alt}
						width={effectiveWidth}
						height={effectiveHeight}
						loading={imgLoading}
						decoding="async"
						style={placeholderStyle || undefined}
					/>
				)}
			</a>
		) : astroImageSrc ? (
			<AstroImage
				src={astroImageSrc}
				alt={alt}
				width={renderWidth}
				height={renderHeight}
				layout="constrained"
				loading="lazy"
				decoding="async"
				style={placeholderStyle || undefined}
			/>
		) : (
			<img
				src={src}
				srcset={srcset}
				sizes={imgSizes}
				alt={alt}
				width={effectiveWidth}
				height={effectiveHeight}
				loading={imgLoading}
				decoding="async"
				style={placeholderStyle || undefined}
			/>
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.emdash-image {
		margin: 1.5rem 0;
	}
	.emdash-image img {
		max-width: 100%;
		height: auto;
	}
	.emdash-image figcaption {
		font-size: 0.875rem;
		color: var(--emdash-caption-color, var(--color-muted, #666));
		margin-top: 0.5rem;
		text-align: center;
	}
	/* Alignment (WordPress-style). Floats wrap surrounding text; wide/full span the column. */
	.emdash-image--align-left,
	.emdash-image--align-right {
		width: fit-content;
		max-width: 50%;
	}
	.emdash-image--align-left {
		float: left;
		margin: 0 1.5rem 1rem 0;
	}
	.emdash-image--align-right {
		float: right;
		margin: 0 0 1rem 1.5rem;
	}
	.emdash-image--align-center {
		width: fit-content;
		margin-inline: auto;
	}
	.emdash-image--align-wide,
	.emdash-image--align-full {
		width: 100%;
	}
	/* On narrow screens, un-float left/right so the image is not cramped beside text. */
	@media (max-width: 640px) {
		.emdash-image--align-left,
		.emdash-image--align-right {
			float: none;
			width: 100%;
			max-width: 100%;
			margin-inline: 0;
		}
	}
</style>
