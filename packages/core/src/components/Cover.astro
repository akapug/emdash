/**
 * Portable Text Cover block component
 *
 * Renders an image/video with text overlay from WordPress imports.
 */
import { getPublicOrigin } from "../api/public-url.js";
import { lazyAutoSizes } from "../media/responsive.js";
import { storedSizesForRender } from "../media/variant-read.js";
import { nestedRenderOf } from "./portable-text-nested.js";

export interface Props {
	node: {
		_type: "cover";
		_key: string;
		backgroundImage?: string;
		backgroundVideo?: string;
		overlayColor?: string;
		overlayOpacity?: number;
		content: unknown[];
		minHeight?: string;
		alignment?: "left" | "center" | "right";
		/** Where the background image sits in its box: `center center`, `center top`, `50% 20%`. Validated before it lands in CSS. */
		backgroundPosition?: string;
		/** How the image blends into the overlay: the CSS `background-blend-mode` set, as an enum, never free text. */
		backgroundBlendMode?: BlendMode;
	};
}

const { node } = Astro.props;
const {
	backgroundImage: storedImage,
	backgroundVideo: storedVideo,
	overlayColor,
	overlayOpacity = 0.5,
	content = [],
	minHeight = "300px",
	alignment = "center",
	backgroundPosition: storedPosition,
	backgroundBlendMode: storedBlend,
} = node ?? {};

/**
 * `background-blend-mode`'s keywords, as a closed set. An enum rather than a string because this value lands in a style attribute: a stored
 * block could otherwise carry `overlay; background-image: url(...)` and reach CSS we never validated.
 */
type BlendMode = "normal" | "multiply" | "screen" | "overlay" | "darken" | "lighten" | "color-dodge" | "color-burn" | "hard-light" | "soft-light" | "difference" | "exclusion" | "hue" | "saturation" | "color" | "luminosity";
const BLEND_MODES: ReadonlySet<string> = new Set<BlendMode>([
	"normal", "multiply", "screen", "overlay", "darken", "lighten", "color-dodge", "color-burn", "hard-light", "soft-light",
	"difference", "exclusion", "hue", "saturation", "color", "luminosity",
]);

/**
 * A CSS `<position>` of one or two parts, each a keyword or a percentage/length. Refused whole rather than repaired: this string is written
 * into a style attribute, and "mostly valid" is how a stylesheet gets a declaration nobody wrote.
 */
const POSITION = /^(?:(?:left|right|center|top|bottom)(?:\s+(?:left|right|center|top|bottom))?|(?:-?\d+(?:\.\d+)?(?:px|%|em|rem))(?=\s|$)(?:\s+(?:-?\d+(?:\.\d+)?(?:px|%|em|rem)))?)$/iu;
const backgroundPosition = typeof storedPosition === "string" && POSITION.test(storedPosition.trim()) ? storedPosition.trim() : undefined;
const backgroundBlendMode: BlendMode | undefined =
	typeof storedBlend === "string" && BLEND_MODES.has(storedBlend) ? (storedBlend as BlendMode) : undefined;

// Content imported before the converter read WordPress's `backgroundType` holds a
// video's URL as `backgroundImage`; drawn as an <img> it is a broken image. A
// video file's extension is the one signal that survives in that stored block.
const VIDEO_FILE = /\.(?:mp4|m4v|mov|webm|ogv)(?:[?#]|$)/iu;
const backgroundVideo = storedVideo ?? (storedImage && VIDEO_FILE.test(storedImage) ? storedImage : undefined);
const backgroundImage = backgroundVideo ? undefined : storedImage;

// The content is drawn with EmDash's own PortableText and the components the
// page drew this block with (portable-text-nested.ts). Imported when drawn:
// PortableText.astro imports index.ts, which imports this component.
const { default: PortableText } = await import("./PortableText.astro");
const nested = nestedRenderOf(node);

// THE LADDER, from the same read the inline images use. Covers and cards were 56% of
// one real home page's image bytes, so a cover that renders no srcset is the biggest
// single miss on the page. Empty (no variants, no readable key, no database) means no
// srcset and markup identical to a site with no variants.
let coverSrcset: string | undefined;
let coverSizes: string | undefined;
if (backgroundImage && !backgroundVideo) {
	// A cover is drawn at the viewport's width, which we cannot know at render time, so
	// the ladder offers what is stored and lets the browser choose. That slot is known
	// (`sizes="100vw"` is true), so the original may close the list when the stored
	// sizes fall short of the screen.
	const stored = await storedSizesForRender(
		{ url: backgroundImage, origin: getPublicOrigin(Astro.url, Astro.locals.emdash?.config) },
		Number.MAX_SAFE_INTEGER,
		{ offerOriginal: true },
	);
	if (stored) {
		coverSrcset = stored.srcset;
		coverSizes = "100vw";
	}
}

const coverLoading = "lazy";
const coverImgSizes = lazyAutoSizes(coverSizes, {
	loading: coverLoading,
	hasWidthSrcset: Boolean(coverSrcset),
	// The background fills the cover's CSS box, not its own intrinsic dimensions.
	hasReservedBox: true,
	sources: [backgroundImage],
});
const hasBackground = backgroundImage || backgroundVideo;
const overlayStyle = overlayColor
	? `background-color: ${overlayColor}; opacity: ${overlayOpacity};`
	: `background-color: rgba(0, 0, 0, ${overlayOpacity});`;
---

<div
	class:list={["emdash-cover", `emdash-cover--align-${alignment}`]}
	style={`min-height: ${minHeight};`}
>
	{
		backgroundImage && !backgroundVideo && (
			<img
				src={backgroundImage}
				alt=""
				class="emdash-cover__background"
				loading={coverLoading}
				srcset={coverSrcset}
				sizes={coverImgSizes}
				style={[
					backgroundPosition ? `object-position: ${backgroundPosition};` : "",
					backgroundBlendMode ? `mix-blend-mode: ${backgroundBlendMode};` : "",
				].filter(Boolean).join(" ") || undefined}
			/>
		)
	}
	{
		backgroundVideo && (
			<video
				class="emdash-cover__background emdash-cover__video"
				autoplay
				muted
				loop
				playsinline
			>
				<source src={backgroundVideo} />
			</video>
		)
	}
	{hasBackground && <div class="emdash-cover__overlay" style={overlayStyle} />}
	<div class="emdash-cover__content">
		<PortableText value={content} {...nested} />
	</div>
</div>

<style>
	.emdash-cover {
		position: relative;
		display: flex;
		align-items: center;
		padding: 2rem;
		margin: 1.5rem 0;
		overflow: hidden;
		border-radius: 4px;
		background-color: var(--emdash-cover-fallback-bg, #333);
	}

	.emdash-cover__background {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}

	.emdash-cover__video {
		object-fit: cover;
	}

	.emdash-cover__overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.emdash-cover__content {
		position: relative;
		z-index: 2;
		width: 100%;
		color: var(--emdash-cover-text-color, #fff);
	}

	.emdash-cover--align-left {
		justify-content: flex-start;
		text-align: left;
	}

	.emdash-cover--align-center {
		justify-content: center;
		text-align: center;
	}

	.emdash-cover--align-right {
		justify-content: flex-end;
		text-align: right;
	}

	.emdash-cover__content :global(h1),
	.emdash-cover__content :global(h2),
	.emdash-cover__content :global(h3),
	.emdash-cover__content :global(h4),
	.emdash-cover__content :global(p) {
		color: inherit;
	}
</style>
