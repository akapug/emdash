---
/**
 * Portable Text Cover block component
 *
 * Renders an image/video with text overlay from WordPress imports.
 */
import { getPublicOrigin } from "../api/public-url.js";
import { lazyAutoSizes } from "../media/responsive.js";
import { storedSizesForRender } from "../media/variant-read.js";
import { nestedRenderOf } from "./portable-text-nested.js";

export interface Props {
	node: {
		_type: "cover";
		_key: string;
		backgroundImage?: string;
		backgroundVideo?: string;
		backgroundPosition?: string;
		backgroundBlendMode?: string;
		overlayColor?: string;
		overlayOpacity?: number;
		content: unknown[];
		minHeight?: string;
		alignment?: "left" | "center" | "right";
		/** The source drew this section edge to edge (Avada's `hundred_percent="yes"`). */
		fullBleed?: boolean;
		/** The section's own vertical padding: px only, 0–600, anything else dropped. */
		paddingTop?: number;
		paddingBottom?: number;
	};
}

const COVER_POSITION_RE =
	/^(?:top|center|bottom|left|right|-?\d{1,3}(?:\.\d{1,2})?%)(?:\s+(?:top|center|bottom|left|right|-?\d{1,3}(?:\.\d{1,2})?%))?$/i;

const COVER_BLEND_MODES = new Set([
	"multiply",
	"screen",
	"overlay",
	"darken",
	"lighten",
	"color-dodge",
	"color-burn",
	"soft-light",
	"hard-light",
	"normal",
]);

const { node } = Astro.props;
const {
	backgroundImage: storedImage,
	backgroundVideo: storedVideo,
	backgroundPosition: rawBackgroundPosition,
	backgroundBlendMode: rawBackgroundBlendMode,
	overlayColor,
	overlayOpacity = 0.5,
	content = [],
	minHeight = "300px",
	alignment = "center",
} = node ?? {};

// Content imported before the converter read WordPress's `backgroundType` holds a
// video's URL as `backgroundImage`; drawn as an <img> it is a broken image. A
// video file's extension is the one signal that survives in that stored block.
const VIDEO_FILE = /\.(?:mp4|m4v|mov|webm|ogv)(?:[?#]|$)/iu;
const backgroundVideo = storedVideo ?? (storedImage && VIDEO_FILE.test(storedImage) ? storedImage : undefined);
const backgroundImage = backgroundVideo ? undefined : storedImage;

// The content is drawn with EmDash's own PortableText and the components the
// page drew this block with (portable-text-nested.ts). Imported when drawn:
// PortableText.astro imports index.ts, which imports this component.
const { default: PortableText } = await import("./PortableText.astro");
const nested = nestedRenderOf(node);

// THE LADDER, from the same read the inline images use. Covers and cards were 56% of
// one real home page's image bytes, so a cover that renders no srcset is the biggest
// single miss on the page. Empty (no variants, no readable key, no database) means no
// srcset and markup identical to a site with no variants.
let coverSrcset: string | undefined;
let coverSizes: string | undefined;
if (backgroundImage && !backgroundVideo) {
	// A cover is drawn at the viewport's width, which we cannot know at render time, so
	// the ladder offers what is stored and lets the browser choose. That slot is known
	// (`sizes="100vw"` is true), so the original may close the list when the stored
	// sizes fall short of the screen.
	const stored = await storedSizesForRender(
		{ url: backgroundImage, origin: getPublicOrigin(Astro.url, Astro.locals.emdash?.config) },
		Number.MAX_SAFE_INTEGER,
		{ offerOriginal: true },
	);
	if (stored) {
		coverSrcset = stored.srcset;
		coverSizes = "100vw";
	}
}

const coverLoading = "lazy";
const coverImgSizes = lazyAutoSizes(coverSizes, {
	loading: coverLoading,
	hasWidthSrcset: Boolean(coverSrcset),
	// The background fills the cover's CSS box, not its own intrinsic dimensions.
	hasReservedBox: true,
	sources: [backgroundImage],
});
const trimmedPosition =
	typeof rawBackgroundPosition === "string" ? rawBackgroundPosition.trim() : "";
const validPosition =
	trimmedPosition && COVER_POSITION_RE.test(trimmedPosition)
		? trimmedPosition.replace(/\s+/g, " ").toLowerCase()
		: undefined;
const backgroundStyle = validPosition ? `object-position: ${validPosition};` : undefined;

const normalizedBlendMode =
	typeof rawBackgroundBlendMode === "string" ? rawBackgroundBlendMode.trim().toLowerCase() : "";
const validBlendMode = COVER_BLEND_MODES.has(normalizedBlendMode) ? normalizedBlendMode : undefined;

/**
 * A padding the section states, or undefined.
 *
 * px ONLY, 0–600, and NOTHING ELSE: this becomes a CSS length, so `175`, `175px; color: red` and `-5` all have to be refused rather than
 * repaired. A number is accepted because a stored block may hold one; a string must be exactly `<digits>px`.
 */
function paddingOf(value: unknown): number | undefined {
	const n = typeof value === "number" ? value : typeof value === "string" && /^\d{1,3}px$/u.test(value.trim()) ? Number.parseInt(value, 10) : NaN;
	return Number.isFinite(n) && Number.isInteger(n) && n >= 0 && n <= 600 ? n : undefined;
}
const padTop = paddingOf(node?.paddingTop);
const padBottom = paddingOf(node?.paddingBottom);
const fullBleed = node?.fullBleed === true;

const hasBackground = backgroundImage || backgroundVideo;
const baseOverlayStyle = overlayColor
	? `background-color: ${overlayColor}; opacity: ${overlayOpacity};`
	: `background-color: rgba(0, 0, 0, ${overlayOpacity});`;
const overlayStyle = validBlendMode
	? `${baseOverlayStyle} mix-blend-mode: ${validBlendMode};`
	: baseOverlayStyle;
---

<div
	class:list={["emdash-cover", `emdash-cover--align-${alignment}`, fullBleed && "emdash-cover--full-bleed"]}
	style={[
		`min-height: ${minHeight};`,
		padTop !== undefined ? `padding-top: ${padTop}px;` : "",
		padBottom !== undefined ? `padding-bottom: ${padBottom}px;` : "",
	].filter(Boolean).join(" ")}
>
	{
		backgroundImage && !backgroundVideo && (
			<img
				src={backgroundImage}
				alt=""
				class="emdash-cover__background"
				style={backgroundStyle}
				loading={coverLoading}
				srcset={coverSrcset}
				sizes={coverImgSizes}
			/>
		)
	}
	{
		backgroundVideo && (
			<video
				class="emdash-cover__background emdash-cover__video"
				style={backgroundStyle}
				autoplay
				muted
				loop
				playsinline
			>
				<source src={backgroundVideo} />
			</video>
		)
	}
	{hasBackground && <div class="emdash-cover__overlay" style={overlayStyle} />}
	<div class="emdash-cover__content">
		<PortableText value={content} {...nested} />
	</div>
</div>

<style>
	/*
	 * A FULL-BLEED SECTION ESCAPES A CENTRED COLUMN. The page body may be capped at the shell's measured contentWidth and centred (a
	 * migrated Avada site's 1100px), and a section the source drew edge to edge must break out of that cap — `100vw` wide and pulled back
	 * to the viewport's left edge by the same amount the column is inset. `overflow: hidden` goes with it: a breakout that clips would be
	 * invisible past the column.
	 */
	.emdash-cover--full-bleed {
		width: 100vw;
		max-width: 100vw;
		margin-left: calc(50% - 50vw);
		margin-right: calc(50% - 50vw);
		padding-left: max(2rem, calc(50vw - 50%));
		padding-right: max(2rem, calc(50vw - 50%));
	}

	.emdash-cover {
		position: relative;
		display: flex;
		align-items: center;
		padding: 2rem;
		margin: 1.5rem 0;
		overflow: hidden;
		border-radius: 4px;
		background-color: var(--emdash-cover-fallback-bg, #333);
	}

	.emdash-cover__background {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}

	.emdash-cover__video {
		object-fit: cover;
	}

	.emdash-cover__overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.emdash-cover__content {
		position: relative;
		z-index: 2;
		width: 100%;
		color: var(--emdash-cover-text-color, #fff);
	}

	.emdash-cover--align-left {
		justify-content: flex-start;
		text-align: left;
	}

	.emdash-cover--align-center {
		justify-content: center;
		text-align: center;
	}

	.emdash-cover--align-right {
		justify-content: flex-end;
		text-align: right;
	}

	.emdash-cover__content :global(h1),
	.emdash-cover__content :global(h2),
	.emdash-cover__content :global(h3),
	.emdash-cover__content :global(h4),
	.emdash-cover__content :global(p) {
		color: inherit;
	}
</style>
